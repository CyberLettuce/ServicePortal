</html>

@code {
    [Inject]
    private IConfiguration Configuration { get; set; } = default!;

    private string BaseHref
    {
        get
        {
            var pathBase = Configuration["PathBase"]?.Trim().Trim('/');
            return string.IsNullOrWhiteSpace(pathBase)
                ? "/"
                : $"/{pathBase}/";
        }
    }
}

