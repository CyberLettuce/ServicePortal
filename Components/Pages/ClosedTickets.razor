@page "/closedtickets"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "TicketsModule")]
@rendermode InteractiveServer
@using ServicePortal.Services
@inject TicketService TicketService
@inject NavigationManager Navigation

<PageHeader Title="Closed Tickets" Description="Completed support tickets."><Actions><button type="button" class="btn btn-outline-secondary" @onclick="RefreshAsync"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button></Actions></PageHeader>
@if(tickets.Count == 0) { <div class="alert alert-info">There are no closed tickets.</div> }
else {
<div class="card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-3"><label class="form-label">Search</label><input class="form-control" @bind="search" @bind:event="oninput" placeholder="Number, description or user" /></div><div class="col-md-3"><label class="form-label">Priority</label><select class="form-select" @bind="priorityFilter"><option value="">All priorities</option>@foreach(var item in Priorities){<option>@item</option>}</select></div><div class="col-md-3"><label class="form-label">Category</label><select class="form-select" @bind="categoryFilter"><option value="">All categories</option>@foreach(var item in Categories){<option>@item</option>}</select></div><div class="col-md-3"><label class="form-label">Assigned To</label><select class="form-select" @bind="assignedFilter"><option value="">All users</option>@foreach(var item in Assignees){<option>@item</option>}</select></div><div class="col-md-3"><label class="form-label">Columns</label><details class="ticket-column-menu"><summary>Choose columns</summary><div class="p-2 border rounded bg-body"><label><input type="checkbox" @bind="showNumber" /> Number</label><label><input type="checkbox" @bind="showDescription" /> Description</label><label><input type="checkbox" @bind="showPriority" /> Priority</label><label><input type="checkbox" @bind="showCategory" /> Category</label><label><input type="checkbox" @bind="showAssigned" /> Assigned to</label></div></details></div></div></div></div>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr>@if(showNumber){<th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("No")'>No</button></th>}@if(showDescription){<th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Description")'>Description</button></th>}@if(showPriority){<th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Priority")'>Priority</button></th>}<th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Status")'>Status</button></th>@if(showCategory){<th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Category")'>Category</button></th>}@if(showAssigned){<th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Assigned")'>Assigned To</button></th>}</tr></thead><tbody>@foreach(var ticket in FilteredTickets){<tr class="ticket-row" @onclick="()=>OpenTicket(ticket.TicketNumber)">@if(showNumber){<td>@(string.IsNullOrWhiteSpace(ticket.TicketReference) ? $"#{ticket.TicketNumber}" : ticket.TicketReference)</td>}@if(showDescription){<td>@ticket.Description</td>}@if(showPriority){<td>@ticket.Priority</td>}<td><span class="badge bg-secondary">Closed</span></td>@if(showCategory){<td>@ticket.Category</td>}@if(showAssigned){<td>@ticket.AssignedTo</td>}</tr>}</tbody></table></div> }

@code { private List<ServicePortal.Models.Ticket> tickets=[]; private string search="",priorityFilter="",categoryFilter="",assignedFilter="",sortColumn="No"; private bool sortAscending=false,showNumber=true,showDescription=true,showPriority=true,showCategory=true,showAssigned=true; private IEnumerable<string> Priorities=>tickets.Select(x=>x.Priority).Distinct().Order(); private IEnumerable<string> Categories=>tickets.Select(x=>x.Category).Distinct().Order(); private IEnumerable<string> Assignees=>tickets.Select(x=>x.AssignedTo).Distinct().Order(); private IEnumerable<ServicePortal.Models.Ticket> FilteredTickets {get {var list=tickets.Where(x=>(priorityFilter==""||x.Priority==priorityFilter)&&(categoryFilter==""||x.Category==categoryFilter)&&(assignedFilter==""||x.AssignedTo==assignedFilter)&&(string.IsNullOrWhiteSpace(search)||x.Description.Contains(search,StringComparison.OrdinalIgnoreCase)||x.TicketReference.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Category.Contains(search,StringComparison.OrdinalIgnoreCase)||x.AssignedTo.Contains(search,StringComparison.OrdinalIgnoreCase)));return(sortColumn,sortAscending)switch{("Description",true)=>list.OrderBy(x=>x.Description),("Description",false)=>list.OrderByDescending(x=>x.Description),("Priority",true)=>list.OrderBy(x=>x.Priority),("Priority",false)=>list.OrderByDescending(x=>x.Priority),("Category",true)=>list.OrderBy(x=>x.Category),("Category",false)=>list.OrderByDescending(x=>x.Category),("Assigned",true)=>list.OrderBy(x=>x.AssignedTo),("Assigned",false)=>list.OrderByDescending(x=>x.AssignedTo),("No",true)=>list.OrderBy(x=>x.TicketNumber),_=>list.OrderByDescending(x=>x.TicketNumber)};}} protected override async Task OnInitializedAsync(){await TicketService.LoadAsync();tickets=TicketService.GetTickets().Where(x=>x.Status=="Closed").ToList();} private void SortBy(string value){if(sortColumn==value)sortAscending=!sortAscending;else{sortColumn=value;sortAscending=true;}} private void OpenTicket(int id)=>Navigation.NavigateTo($"ticket/{id}"); private async Task RefreshAsync(){await TicketService.LoadAsync();tickets=TicketService.GetTickets().Where(ticket=>ticket.Status=="Closed").ToList();} }


