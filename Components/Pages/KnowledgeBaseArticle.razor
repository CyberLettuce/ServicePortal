@page "/knowledge-base/article/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ServicePortal.Data
@using ServicePortal.Services
@attribute [Authorize(Policy = "TicketsModule")]
@inject KnowledgeBaseService KnowledgeBaseService

@if (article is null) { <div class="alert alert-warning">This article is unavailable.</div> }
else { <PageHeader Title="@article.Title" Description="@article.Summary"><Actions><a class="btn btn-outline-secondary" href="knowledge-base"><i class="bi bi-arrow-left me-1"></i>Knowledge Base</a></Actions></PageHeader>
<div class="row g-4"><div class="col-lg-8"><div class="card ticket-details-surface"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-book"></i><div><strong>Knowledge Base article</strong><div class="small">Guidance and self-service support information</div></div></div></div><div class="card-body"><h2 class="h5">Symptoms</h2><div class="kb-content">@article.Symptoms</div><hr /><h2 class="h5">Resolution</h2><div class="kb-content">@article.Resolution</div>@if (!string.IsNullOrWhiteSpace(article.AdditionalInformation)) { <hr /><h2 class="h5">Additional information</h2><div class="kb-content">@article.AdditionalInformation</div> }<hr /><strong>Was this article useful?</strong><div class="mt-2"><button class="btn btn-outline-success me-2" @onclick="() => RateAsync(true)"><i class="bi bi-hand-thumbs-up me-1"></i>Useful</button><button class="btn btn-outline-secondary" @onclick="() => RateAsync(false)"><i class="bi bi-hand-thumbs-down me-1"></i>Not useful</button></div>@if (!string.IsNullOrWhiteSpace(ratingMessage)) { <div class="small text-success mt-2">@ratingMessage</div> }</div></div></div><div class="col-lg-4"><div class="card ticket-details-surface"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-link-45deg"></i><div><strong>Related articles</strong><div class="small">More help on this subject</div></div></div></div><div class="list-group list-group-flush">@foreach (var item in related) { <a class="list-group-item list-group-item-action" href="knowledge-base/article/@item.Id">@item.Title</a> }</div></div></div></div> }
@code { [Parameter] public int Id { get; set; } private KnowledgeArticle? article; private List<KnowledgeArticle> related = []; private string ratingMessage = string.Empty; protected override async Task OnParametersSetAsync() { article = await KnowledgeBaseService.GetArticleAsync(Id); if (article is not null) related = (await KnowledgeBaseService.GetArticlesAsync()).Where(item => item.Id != article.Id && (item.CategoryId == article.CategoryId || item.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Intersect(article.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries), StringComparer.OrdinalIgnoreCase).Any())).Take(5).ToList(); } private async Task RateAsync(bool useful) { await KnowledgeBaseService.RateAsync(Id, useful); ratingMessage = "Thank you for your feedback."; } }
