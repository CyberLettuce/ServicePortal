@page "/testing/repository"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using ServicePortal.Data
@using ServicePortal.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize(Policy = "TestingModule")]
@inject TestingService TestingService
@inject TestKitDocumentService TestKitDocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Regression Test Templates</PageTitle>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><h1 class="mb-1">Regression Test Templates</h1><p class="text-muted mb-0">Reusable regression checks for each software and release.</p></div><NavLink class="btn btn-primary" href="testing"><i class="bi bi-calendar-plus me-1"></i>Open Current Testing</NavLink></div>
<ul class="nav nav-pills mb-4"><li class="nav-item"><NavLink class="nav-link" href="testing" Match="NavLinkMatch.All">Current Testing</NavLink></li><li class="nav-item"><NavLink class="nav-link" href="testing/history">Previous Months</NavLink></li><li class="nav-item"><NavLink class="nav-link" href="testing/repository">Test Case Repository</NavLink></li></ul>
@if (message is not null) { <div class="alert alert-success">@message</div> }
<div class="card mb-4"><div class="card-header"><strong>Test Kits</strong></div><div class="card-body"><div><strong>Upload a Word test kit</strong><div class="text-muted small">The test-case tables are read automatically and added to the repository with their references, steps, and expected results.</div></div><div class="row align-items-end g-3 mt-1"><div class="col-md"><label class="form-label">Test kit file</label><InputFile class="form-control" accept=".docx" OnChange="UploadKitAsync" /></div><div class="col-md-auto"><span class="text-muted small">Word document · up to 25 MB</span></div></div>@if (testKits.Count > 0) { <div class="list-group mt-4">@foreach (var kit in testKits) { <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2"><div><strong><i class="bi bi-file-earmark-text me-2"></i>@kit.OriginalFileName</strong><div class="small text-muted">Uploaded by @kit.UploadedBy · @kit.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy") · @FormatSize(kit.SizeBytes) · @kit.ImportedCaseCount case@(kit.ImportedCaseCount == 1 ? "" : "s") imported</div></div><a class="btn btn-sm btn-outline-secondary" href="testing/test-kits/@kit.Id/download"><i class="bi bi-download me-1"></i>Download</a></div> }</div> }</div></div>
<div class="row g-4"><div class="col-lg-4"><div class="card"><div class="card-header"><strong>Add individual regression check</strong></div><div class="card-body"><p class="text-muted small">Use this for a single new case without uploading a whole test kit.</p><EditForm Model="newPlan" OnValidSubmit="AddAsync"><DataAnnotationsValidator /><ValidationSummary class="text-danger mb-3" />
<div class="mb-3"><label class="form-label">Software</label><InputSelect class="form-select" @bind-Value="newPlan.Product" @bind-Value:after="ProductChanged">@foreach (var product in ProductList) { <option value="@product">@product</option> }</InputSelect></div>
<div class="mb-3"><label class="form-label">@ScopeLabel</label>@if (newPlan.Product == "eCERT") { <InputSelect class="form-select" @bind-Value="newPlan.Scope">@foreach (var country in Countries) { <option value="@country">@country</option> }</InputSelect> } else if (newPlan.Product == "eGTA") { <InputText class="form-control" list="modules" @bind-Value="newPlan.Scope" /><datalist id="modules">@foreach (var item in Modules) { <option value="@item"></option> }</datalist> } else { <InputText class="form-control" @bind-Value="newPlan.Scope" placeholder="Area" /> }</div>
<div class="mb-3"><label class="form-label">Reference</label><InputText class="form-control" @bind-Value="newPlan.Reference" placeholder="e.g. CDS-CTRL-A" /></div>
<div class="mb-3"><label class="form-label">Test case</label><InputText class="form-control" @bind-Value="newPlan.TestCaseName" /></div>
<div class="mb-3"><label class="form-label">Instructions</label><InputTextArea class="form-control" @bind-Value="newPlan.Instructions" /></div><div class="mb-3"><label class="form-label">Expected result</label><InputTextArea class="form-control" @bind-Value="newPlan.ExpectedResult" /></div>
<div class="form-text mb-3">Every regression check requires two testers.</div>
<button class="btn btn-primary w-100" type="submit"><i class="bi bi-plus-lg me-1"></i>Add individual case</button></EditForm></div></div></div>
<div class="col-lg-8"><div class="card"><div class="card-header"><strong>Active regression checks</strong></div><div class="card-body border-bottom"><div class="btn-group flex-wrap">@foreach (var item in Filters) { <button class="btn @(selectedProduct == item ? "btn-primary" : "btn-outline-primary")" @onclick="() => selectedProduct = item">@item</button> }</div></div>@if (FilteredPlans.Count == 0) { <div class="card-body text-muted">No regression checks match this filter.</div> } else { @foreach (var software in FilteredPlans.GroupBy(plan => plan.Product)) { <div class="card-body border-bottom pb-0"><h2 class="h6 mb-3">@software.Key <span class="badge text-bg-secondary">@software.Count()</span></h2>@foreach (var scope in software.GroupBy(plan => plan.Scope)) { <div class="mb-3"><div class="small fw-semibold text-uppercase text-muted mb-2">@scope.Key</div><div class="list-group">@foreach (var plan in scope) { <div class="list-group-item"><div class="d-flex justify-content-between align-items-start gap-3"><div><strong>@(string.IsNullOrWhiteSpace(plan.Reference) ? plan.TestCaseName : plan.Reference + " · " + plan.TestCaseName)</strong><div class="small text-muted mt-1">Two testers required</div></div><div class="btn-group"><button class="btn btn-sm btn-outline-primary" @onclick="() => BeginEdit(plan)">Edit</button><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(plan)">Delete</button></div></div>@if (!string.IsNullOrWhiteSpace(plan.Instructions)) { <div class="small mt-3"><strong>Instructions:</strong> @plan.Instructions</div> } @if (!string.IsNullOrWhiteSpace(plan.ExpectedResult)) { <div class="small mt-2"><strong>Expected:</strong> @plan.ExpectedResult</div> }</div> }</div></div> }</div> } }</div></div></div>
@if (editingPlan is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Edit regression check</h2><button type="button" class="btn-close" @onclick="CancelEdit"></button></div><EditForm Model="editingPlan" OnValidSubmit="SaveEditAsync"><DataAnnotationsValidator /><div class="modal-body"><ValidationSummary class="text-danger mb-3" /><div class="row g-3"><div class="col-md-6"><label class="form-label">Software</label><InputSelect class="form-select" @bind-Value="editingPlan.Product">@foreach (var product in ProductList) { <option value="@product">@product</option> }</InputSelect></div><div class="col-md-6"><label class="form-label">Section</label><InputText class="form-control" @bind-Value="editingPlan.Scope" /></div><div class="col-md-6"><label class="form-label">Reference</label><InputText class="form-control" @bind-Value="editingPlan.Reference" /></div><div class="col-md-6"><label class="form-label">Test case</label><InputText class="form-control" @bind-Value="editingPlan.TestCaseName" /></div><div class="col-12"><label class="form-label">Instructions</label><InputTextArea class="form-control" rows="4" @bind-Value="editingPlan.Instructions" /></div><div class="col-12"><label class="form-label">Expected result</label><InputTextArea class="form-control" rows="4" @bind-Value="editingPlan.ExpectedResult" /></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button><button type="submit" class="btn btn-primary">Save changes</button></div></EditForm></div></div></div>
}
@code {
 private static readonly string[] ProductList = ["eCERT","eGTA","Brokerage Portal"]; private static readonly string[] Countries = ["UK","Canada","Estonia","Ireland","Malta"]; private static readonly string[] Modules = ["CDS","EMCS","ENS","GVMS","eCustoms Brokerage","eCustoms Portal","Send to Brokerage","TransitNet"];
 private static readonly string[] Filters = ["All", .. ProductList]; private List<TestPlan> plans = new(); private string selectedProduct = "All"; private string? message; private Model newPlan = new(); private Model? editingPlan;
 private string ScopeLabel => newPlan.Product == "eCERT" ? "Country" : newPlan.Product == "eGTA" ? "eGTA module" : "Area";
 private List<TestPlan> FilteredPlans => selectedProduct == "All" ? plans : plans.Where(plan => plan.Product == selectedProduct).ToList();
 private List<TestKitDocument> testKits = new(); private string currentUser = string.Empty;
 protected override async Task OnInitializedAsync() { await TestingService.EnsureEcertRegressionTemplateAsync(); plans = await TestingService.GetPlansAsync(); testKits = await TestKitDocumentService.GetAllAsync(); var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var user = await UserManager.GetUserAsync(state.User); currentUser = user?.DisplayName ?? user?.Email ?? "Unknown user"; }
 private void ProductChanged() => newPlan.Scope = newPlan.Product == "eCERT" ? Countries[0] : newPlan.Product == "eGTA" ? "CDS" : string.Empty;
 private async Task AddAsync() { await TestingService.CreatePlanAsync(new TestPlan { Product = newPlan.Product, Scope = newPlan.Scope, Reference = newPlan.Reference, TestCaseName = newPlan.TestCaseName, Instructions = newPlan.Instructions, ExpectedResult = newPlan.ExpectedResult, RequiresSecondTester = true }); newPlan = new(); plans = await TestingService.GetPlansAsync(); message = "Regression check added to the template."; }
 private async Task UploadKitAsync(InputFileChangeEventArgs args) { var file = args.File; var extension = Path.GetExtension(file.Name).ToLowerInvariant(); if (file.Size > 25 * 1024 * 1024 || extension != ".docx") { message = "Choose a Word document up to 25 MB."; return; } await using var stream = file.OpenReadStream(25 * 1024 * 1024); using var memory = new MemoryStream(); await stream.CopyToAsync(memory); var count = await TestKitDocumentService.AddAndImportAsync(Path.GetFileName(file.Name), string.IsNullOrWhiteSpace(file.ContentType) ? "application/vnd.openxmlformats-officedocument.wordprocessingml.document" : file.ContentType, file.Size, memory.ToArray(), currentUser); testKits = await TestKitDocumentService.GetAllAsync(); plans = await TestingService.GetPlansAsync(); message = file.Name + " has been uploaded and " + count + " new test case(s) imported."; }
 private static string FormatSize(long bytes) => bytes < 1024 * 1024 ? Math.Ceiling(bytes / 1024d) + " KB" : Math.Round(bytes / 1024d / 1024d, 1) + " MB";
 private async Task DeleteAsync(TestPlan plan) { await TestingService.DeletePlanAsync(plan.Id); plans = await TestingService.GetPlansAsync(); message = "Test case deleted."; }
 private void BeginEdit(TestPlan plan) => editingPlan = new Model { Id = plan.Id, Product = plan.Product, Scope = plan.Scope, Reference = plan.Reference, TestCaseName = plan.TestCaseName, Instructions = plan.Instructions, ExpectedResult = plan.ExpectedResult };
 private void CancelEdit() => editingPlan = null;
 private async Task SaveEditAsync() { if (editingPlan is null) return; if (await TestingService.UpdatePlanAsync(new TestPlan { Id = editingPlan.Id, Product = editingPlan.Product, Scope = editingPlan.Scope, Reference = editingPlan.Reference, TestCaseName = editingPlan.TestCaseName, Instructions = editingPlan.Instructions, ExpectedResult = editingPlan.ExpectedResult })) { plans = await TestingService.GetPlansAsync(); editingPlan = null; message = "Regression check updated."; } }
 private sealed class Model { public int Id { get; set; } public string Product { get; set; } = "eCERT"; public string Scope { get; set; } = Countries[0]; public string Reference { get; set; } = string.Empty; [Required] public string TestCaseName { get; set; } = string.Empty; public string Instructions { get; set; } = string.Empty; public string ExpectedResult { get; set; } = string.Empty; }
}

