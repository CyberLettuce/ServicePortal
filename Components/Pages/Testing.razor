@page "/testing"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using ServicePortal.Data
@using ServicePortal.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@attribute [Authorize(Policy = "TestingModule")]
@inject TestingService TestingService
@inject SettingsService SettingsService
@inject AxosoftImportService AxosoftImportService
@inject NavigationManager NavigationManager

<PageHeader Title="Current Testing" Description="The release currently being tested."><Actions><button class="btn btn-primary" @onclick="ShowNewWindow"><i class="bi bi-plus-lg me-1"></i>New Testing Window</button></Actions></PageHeader>
<ul class="nav nav-pills mb-4"><li class="nav-item"><NavLink class="nav-link" href="testing" Match="NavLinkMatch.All">Current Testing</NavLink></li><li class="nav-item"><NavLink class="nav-link" href="testing/history">Previous Months</NavLink></li><li class="nav-item"><NavLink class="nav-link" href="testing/repository">Test Case Repository</NavLink></li></ul>
@if (message is not null) { <div class="alert @messageClass">@message</div> }
@if (windows.Count == 0 && !windowOpen) { <div class="card"><div class="card-body p-5 text-center text-muted">There are no open testing windows. Use <strong>New Testing Window</strong> to begin.</div></div> }
else
{
    <div class="card mb-4"><div class="card-header"><strong>Open testing windows</strong></div><div class="card-body border-bottom"><div class="btn-group">@foreach (var item in Filters) { <button class="btn @(windowFilter == item ? "btn-primary" : "btn-outline-primary")" @onclick="() => windowFilter = item">@item</button> }</div></div><div class="card-body"><div class="row g-3">@foreach (var window in FilteredWindows) { <div class="col-md-6 col-xl-4"><button class="card h-100 w-100 text-start border @(window.Product == product && window.ReleaseNumber == releaseNumber ? "border-primary shadow-sm" : "")" style="background: var(--bs-body-bg);" @onclick="() => SelectWindowAsync(window)"><div class="card-body"><div class="d-flex justify-content-between align-items-start gap-2"><div><div class="text-muted small text-uppercase">@window.Product</div><div class="h5 mb-1">Release @window.ReleaseNumber</div></div><span class="badge @(window.Status == "Ready for live" ? "bg-success" : "bg-warning text-dark")">@window.Status</span></div><div class="text-muted small mt-3"><i class="bi bi-calendar3 me-1"></i>@window.Month.ToString("MMMM yyyy")</div><div class="text-muted small mt-1"><i class="bi bi-list-check me-1"></i>@window.PointCount point@(window.PointCount == 1 ? "" : "s")</div></div></button></div> }</div></div></div>
    @if (windowOpen)
    {
        <div class="row g-4"><div class="col-lg-4"><div class="card"><div class="card-header"><strong>Release actions</strong></div><div class="card-body">
            <EditForm Model="newPoint" OnValidSubmit="AddPointAsync"><DataAnnotationsValidator /><ValidationSummary class="text-danger mb-3" /><div class="mb-3"><label class="form-label">Axosoft ID</label><InputText class="form-control" @bind-Value="newPoint.Scope" /></div><div class="mb-3"><label class="form-label">Test Description</label><InputText class="form-control" @bind-Value="newPoint.TestCaseName" /></div><div class="form-text mb-3">Every test point requires two testers.</div><button class="btn btn-outline-primary w-100" type="submit">Add test</button></EditForm>
            <div class="mt-3"><label class="form-label fw-semibold">Import test log</label><InputFile class="form-control" accept=".csv,.xlsx" OnChange="ImportAxosoftAsync" /><div class="form-text">Choose an Axosoft or JIRA CSV/Excel export. Matching release rows are imported automatically.</div></div>
        </div></div></div>
        <div class="col-lg-8"><div class="card"><div class="card-header"><strong>@product · Release @releaseNumber</strong></div><div class="card-body border-bottom"><div class="row g-2 align-items-end"><div class="col-md-7"><label class="form-label mb-1">Live release date</label><InputDate class="form-control" @bind-Value="liveDate" /></div><div class="col-md-5"><button class="btn btn-success w-100" @onclick="FinishAsync">Testing finished</button></div></div></div>
        @if (windowRuns.Count == 0) { <div class="card-body p-4 text-center text-muted">Add a test or generate regression tests below.</div> } else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Test Description</th><th>Status</th><th>Tester</th><th>Second tester</th><th></th></tr></thead><tbody>@foreach (var run in windowRuns) { <tr class="@RowClass(run.Status)" style="cursor: pointer;" @onclick="() => OpenRun(run)"><td><strong class="text-primary">@run.TestCaseName</strong><div class="small text-muted">@run.Scope</div></td><td><span class="badge @StatusBadgeClass(run.Status)">@run.Status</span></td><td>@(string.IsNullOrWhiteSpace(run.TestedBy) ? "Not assigned" : run.TestedBy)</td><td>@(string.IsNullOrWhiteSpace(run.SecondTestedBy) ? "Not assigned" : run.SecondTestedBy)</td><td class="text-nowrap"><button class="btn btn-sm btn-outline-danger" title="Delete test" @onclick="() => DeleteAsync(run)" @onclick:stopPropagation="true">Delete</button></td></tr> }</tbody></table></div> }
        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2"><span class="text-muted small">Add the standard @product regression template as one point in this release. Each check requires two testers.</span><button class="btn btn-primary" @onclick="GenerateRegressionAsync"><i class="bi bi-clipboard2-check me-1"></i>Generate Regression Tests</button></div>
        </div></div></div>
    }
}
@if (showNewWindow)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h2 class="modal-title fs-5">New Testing Window</h2><button type="button" class="btn-close" @onclick="CloseNewWindow"></button></div>
            <div class="modal-body"><div class="mb-3"><label class="form-label">Software</label><select class="form-select" @bind="newProduct"><option>eCERT</option><option>eGTA</option><option>Brokerage Portal</option></select></div><div class="mb-3"><label class="form-label">Release number</label><input class="form-control" @bind="newReleaseNumber" placeholder="e.g. 2026.09.1" /></div><div class="mb-0"><label class="form-label">Testing month</label><input type="month" class="form-control" value="@newMonthText" @onchange="NewMonthChanged" /></div></div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="CloseNewWindow">Cancel</button><button class="btn btn-primary" @onclick="CreateNewWindow">Open testing window</button></div>
        </div></div>
    </div>
}
@code {
 [SupplyParameterFromQuery(Name="month")] public string? QueryMonth { get; set; } [SupplyParameterFromQuery(Name="product")] public string? QueryProduct { get; set; } [SupplyParameterFromQuery(Name="release")] public string? QueryRelease { get; set; }
 private static readonly string[] Statuses = ["Not Started","In Progress","Pass","Fail"]; private static readonly string[] Filters = ["All","eCERT","eGTA","Brokerage Portal"]; private List<TestRun> windowRuns = new(); private List<string> testers = new(); private List<TestingWindow> windows = new(); private string windowFilter = "All"; private string monthText = DateTime.Today.ToString("yyyy-MM"); private string product = string.Empty; private string releaseNumber = string.Empty; private DateTime liveDate = DateTime.Today; private bool windowOpen; private bool showNewWindow; private string newProduct = "eCERT"; private string newReleaseNumber = string.Empty; private string newMonthText = DateTime.Today.ToString("yyyy-MM"); private string? message; private string messageClass = "alert-success"; private PointModel newPoint = new();
 private DateTime Month => DateTime.TryParse(monthText + "-01", out var value) ? new(value.Year,value.Month,1) : new(DateTime.Today.Year,DateTime.Today.Month,1);
 private List<TestingWindow> FilteredWindows => windowFilter == "All" ? windows : windows.Where(window => window.Product == windowFilter).ToList();
 protected override async Task OnInitializedAsync() { await SettingsService.LoadAsync(); testers = await TestingService.GetTestersAsync(); monthText = QueryMonth ?? monthText; product = QueryProduct ?? product; releaseNumber = QueryRelease ?? releaseNumber; windowOpen = !string.IsNullOrWhiteSpace(product) && !string.IsNullOrWhiteSpace(releaseNumber); await LoadAsync(); if (!windowOpen && windows.Count > 0) await SelectWindowAsync(windows[0]); }
 private async Task LoadAsync() { windows = await TestingService.GetWindowsAsync(false); windowRuns = string.IsNullOrWhiteSpace(product) ? new() : (await TestingService.GetRunsAsync(Month)).Where(run => run.Product == product && run.ReleaseNumber == releaseNumber).ToList(); }
 private async Task SelectWindowAsync(TestingWindow window) { monthText = window.Month.ToString("yyyy-MM"); product = window.Product; releaseNumber = window.ReleaseNumber; liveDate = window.LiveDate ?? DateTime.Today; windowOpen = true; await LoadAsync(); }
 private void ShowNewWindow() { newProduct = SettingsService.Current.TestingDefaultSoftware; newReleaseNumber = string.Empty; newMonthText = DateTime.Today.ToString("yyyy-MM"); showNewWindow = true; }
 private void CloseNewWindow() => showNewWindow = false;
 private void NewMonthChanged(ChangeEventArgs e) => newMonthText = e.Value?.ToString() ?? newMonthText;
 private async Task CreateNewWindow() { if (string.IsNullOrWhiteSpace(newReleaseNumber)) { message = "Enter a release number."; messageClass = "alert-warning"; return; } monthText = newMonthText; product = newProduct; releaseNumber = newReleaseNumber.Trim(); await TestingService.CreateWindowAsync(Month, product, releaseNumber); liveDate = DateTime.Today.AddDays(SettingsService.Current.TestingDefaultLiveDateDays); windowOpen = true; showNewWindow = false; await LoadAsync(); }
 private async Task AddPointAsync() { await TestingService.CreateReleasePointAsync(new TestRun { Product=product, ReleaseNumber=releaseNumber, Scope=newPoint.Scope, TestCaseName=newPoint.TestCaseName, RequiresSecondTester=true, ScheduledDate=Month }); newPoint = new(); await LoadAsync(); message="Point added."; messageClass="alert-success"; }
 private async Task GenerateRegressionAsync() { var count=await TestingService.GenerateRegressionRunAsync(Month,product,releaseNumber); await LoadAsync(); if (count > 0) { message=count+" regression check(s) added inside one Regression Testing point."; messageClass="alert-success"; } else if (count == 0) { message="A Regression Testing point already exists for this release."; messageClass="alert-warning"; } else { message="There are no regression checks for "+product+" yet. Add them in Regression Test Templates first."; messageClass="alert-warning"; } }
 private async Task ImportAxosoftAsync(InputFileChangeEventArgs args) { try { var file = args.File; if (file.Size > 10 * 1024 * 1024) { message="Choose an Axosoft export up to 10 MB."; messageClass="alert-warning"; return; } await using var stream = file.OpenReadStream(10 * 1024 * 1024); using var memory = new MemoryStream(); await stream.CopyToAsync(memory); var items = AxosoftImportService.Parse(file.Name, memory.ToArray()); var matching = items.Where(item => string.Equals(item.Release, releaseNumber, StringComparison.OrdinalIgnoreCase)).ToList(); if (matching.Count == 0) { message="No rows in this export match release " + releaseNumber + "."; messageClass="alert-warning"; return; } var count = await TestingService.CreateAxosoftPointsAsync(Month, product, releaseNumber, matching); await LoadAsync(); message = count == 0 ? "All matching Axosoft IDs are already in this release." : count + " Axosoft test point(s) imported."; messageClass="alert-success"; } catch (Exception ex) { message=ex.Message; messageClass="alert-danger"; } }
 private async Task FinishAsync() { await TestingService.FinishTestingAsync(Month,product,releaseNumber,liveDate); await LoadAsync(); message="Testing finished."; messageClass="alert-success"; }
 private async Task DeleteAsync(TestRun run) { if (await TestingService.DeleteRunAsync(run.Id)) { await LoadAsync(); message="Test point deleted."; messageClass="alert-success"; } }
 private void OpenRun(TestRun run) => NavigationManager.NavigateTo("testing/test/" + run.Id);
 private static string RowClass(string status)=>status switch{"Pass"=>"table-success","Fail"=>"table-danger","In Progress"=>"table-warning",_=>string.Empty}; private static string StatusBadgeClass(string status)=>status switch{"Pass"=>"bg-success","Fail"=>"bg-danger","In Progress"=>"bg-warning text-dark",_=>"bg-secondary"};
 private sealed class PointModel { public string Scope {get;set;}=string.Empty; [Required] public string TestCaseName {get;set;}=string.Empty; }
}
