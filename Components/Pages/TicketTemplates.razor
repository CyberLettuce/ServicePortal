@page "/ticket-templates"
@rendermode InteractiveServer
@using ServicePortal.Data
@using ServicePortal.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "SupportOrAdministrator")]
@inject TicketService TicketService

<PageHeader Title="Ticket Templates" Description="Create reusable ticket details for common support requests." />
<div class="row g-4">
  <div class="col-lg-5"><div class="card ticket-details-surface"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-file-earmark-text"></i><div><strong>@(editing.Id == 0 ? "New template" : "Edit template")</strong><div class="small">Saved templates can be applied while creating a ticket.</div></div></div></div><div class="card-body">
    <div class="mb-3"><label class="form-label">Template name</label><input class="form-control" @bind="editing.Name" /></div>
    <div class="mb-3"><label class="form-label">Main Issue</label><input class="form-control" @bind="editing.MainIssue" /></div><div class="mb-3"><label class="form-label">Additional Details</label><textarea class="form-control" rows="4" @bind="editing.AdditionalDetails"></textarea></div><div class="row g-3"><div class="col-md-6"><label class="form-label">References (LRN)</label><input class="form-control" @bind="editing.ReferencesLrn" /></div><div class="col-md-6"><label class="form-label">Main Contact</label><input class="form-control" @bind="editing.MainContact" /></div></div><div class="mt-3"><label class="form-label">Actions Taken</label><textarea class="form-control" rows="3" @bind="editing.ActionsTaken"></textarea></div>@if (editing.Category == "eGTA") { <div class="mt-3"><label class="form-label">Software Module</label><div class="ticket-egta-options"><div class="ticket-egta-options-grid">@foreach(var option in EgtaOptions){<label class="ticket-egta-option @(IsEgtaSelected(option) ? "selected" : "")"><input type="checkbox" class="form-check-input" checked="@IsEgtaSelected(option)" @onchange="()=>ToggleEgtaOption(option)" /><span>@option</span></label>}</div></div></div> }
    <div class="row g-3"><div class="col-md-6"><label class="form-label">Priority</label><select class="form-select" @bind="editing.Priority"><option value=""></option><option>Low</option><option>Medium</option><option>High</option></select></div><div class="col-md-6"><label class="form-label">Category</label><select class="form-select" @bind="editing.Category"><option>eCERT</option><option>eCONSIGN</option><option>eGTA</option><option>UKCS Portal</option></select></div></div>
    <div class="mt-3"><label class="form-label">Assigned to</label><select class="form-select" @bind="editing.AssignedTo">@foreach(var user in users){<option value="@user">@user</option>}</select></div>
    <div class="mt-4"><button class="btn btn-primary me-2" @onclick="SaveAsync">Save template</button><button class="btn btn-outline-secondary" @onclick="NewTemplate">Clear</button></div>
  </div></div></div>
  <div class="col-lg-7"><div class="card ticket-details-surface"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-collection"></i><div><strong>Saved templates</strong><div class="small">Manage the templates available to your support team.</div></div></div></div><div class="list-group list-group-flush">@if(templates.Count == 0){<div class="list-group-item text-muted">No templates have been created yet.</div>}@foreach(var template in templates){<div class="list-group-item d-flex justify-content-between align-items-start gap-3"><div><strong>@template.Name</strong><div class="small text-muted">@template.Category · @template.Priority · @template.AssignedTo</div><div class="mt-2">@template.AdditionalDetails</div></div><div class="btn-group"><button class="btn btn-sm btn-outline-primary" @onclick="()=>Edit(template)">Edit</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>DeleteAsync(template.Id)">Delete</button></div></div>}</div></div></div>
</div>
@code { private static readonly string[] EgtaOptions = ["CDS Exports", "CDS Imports", "eCustoms Brokerage", "eCustoms Portal", "EMCS", "ENS", "GVMS", "Send to Brokerage", "Send to TransitNet", "TransitNet", "Shipments"]; private List<TicketTemplate> templates = new(); private List<string> users = new(); private TicketTemplate editing = new(); protected override async Task OnInitializedAsync(){ users=await TicketService.GetAssignableUserDisplayNamesAsync(); await LoadAsync(); } private async Task LoadAsync()=>templates=await TicketService.GetTemplatesAsync(); private async Task SaveAsync(){if(string.IsNullOrWhiteSpace(editing.Name))return; await TicketService.SaveTemplateAsync(editing); NewTemplate(); await LoadAsync();} private void Edit(TicketTemplate item)=>editing=new TicketTemplate{Id=item.Id,Name=item.Name,MainIssue=item.MainIssue,AdditionalDetails=item.AdditionalDetails,ReferencesLrn=item.ReferencesLrn,MainContact=item.MainContact,ActionsTaken=item.ActionsTaken,SoftwareModule=item.SoftwareModule,Mrn=item.Mrn,Arc=item.Arc,Tsn=item.Tsn,ShipmentReference=item.ShipmentReference,Priority=item.Priority,Category=item.Category,AssignedTo=item.AssignedTo}; private bool IsEgtaSelected(string option)=>editing.SoftwareModule.Split(";", StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).Contains(option); private void ToggleEgtaOption(string option){var values=editing.SoftwareModule.Split(";", StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).ToHashSet();if(!values.Add(option))values.Remove(option);editing.SoftwareModule=string.Join("; ",EgtaOptions.Where(values.Contains));} private void NewTemplate()=>editing=new TicketTemplate(); private async Task DeleteAsync(int id){await TicketService.DeleteTemplateAsync(id);if(editing.Id==id)NewTemplate();await LoadAsync();} }
