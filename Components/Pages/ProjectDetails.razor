@page "/projects/{Id:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using ServicePortal.Data
@using ServicePortal.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Policy = "ProjectsModule")]
@inject ProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

@if (project is null) { <div class="card">
<div class="card-body text-muted">Loading project...</div>
</div> }
else {
<PageTitle>@project.Name</PageTitle>
<div class="mb-4">
<div class="d-flex justify-content-between align-items-center mb-3">
<button class="btn btn-outline-secondary btn-sm" @onclick='() => Navigation.NavigateTo("projects")'>
<i class="bi bi-arrow-left me-1">
</i>All Projects</button>
<button class="btn btn-outline-danger btn-sm" @onclick="() => confirmDelete = true">
<i class="bi bi-trash me-1">
</i>Delete Project</button>
</div>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
<div class="d-flex align-items-center gap-3">
<button type="button" class="project-title-image" title="Change project image" @onclick="() => showImagePicker = true">@if(!string.IsNullOrWhiteSpace(project.ImageFileName)){<img src="uploads/project-images/@project.ImageFileName" alt="" />}else{<i class="bi bi-image">
</i>}</button>
<div>
<h1 class="mb-1">@project.Name</h1>
<p class="text-muted mb-0">@project.Description</p>
</div>
</div>
<span class="badge fs-6 @StatusClass(project.Status)">@project.Status</span>
</div>
<div class="text-muted small mt-3">
<i class="bi bi-calendar3 me-1">
</i>Target @(project.TargetDate?.ToString("dd/MM/yyyy") ?? "Not set")</div>
</div>
@if (confirmDelete) { <div class="alert alert-danger d-flex justify-content-between align-items-center flex-wrap gap-3">
<div>
<strong>Delete this project?</strong>
<div class="small">This will also remove its full timeline, including updates, risks, and decisions.</div>
</div>
<div>
<button class="btn btn-danger me-2" @onclick="DeleteAsync">Delete project</button>
<button class="btn btn-outline-secondary" @onclick="() => confirmDelete = false">Cancel</button>
</div>
</div> }
@if(showImagePicker){<div class="project-image-modal-backdrop" @onclick="() => showImagePicker = false">
<div class="project-image-modal" @onclick:stopPropagation="true">
<div class="d-flex justify-content-between align-items-center mb-3">
<strong>Choose project image</strong>
<button class="btn-close" @onclick="() => showImagePicker = false">
</button>
</div>
<InputFile class="form-control" accept="image/png,image/jpeg,image/webp" OnChange="UploadImageAsync" />
<div class="form-text mt-2">PNG, JPG, or WebP up to 5 MB.</div>
</div>
</div>}
<div class="card mb-4 project-history-card">
<div class="card-body">
<div class="d-flex justify-content-between align-items-center mb-4">
<strong>
<i class="bi bi-signpost-split me-2">
</i>Project history</strong>
<span class="small text-muted">Last updated @project.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
</div>
<div class="project-history-track">
<div class="project-history-event project-history-start">
<span class="project-history-dot">
</span>
<strong>Started</strong>
<small>@project.StartDate.ToString("dd/MM/yyyy")</small>
</div>@foreach(var milestone in project.Updates.OrderBy(item => item.CreatedAt)){<div class="project-history-event">
<span class="project-history-dot milestone">
</span>
<strong>@milestone.Message</strong>
<small>@milestone.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
</div>}@if(project.TargetDate.HasValue){<div class="project-history-event project-history-target">
<span class="project-history-dot target">
</span>
<strong>Target</strong>
<small>@project.TargetDate.Value.ToString("dd/MM/yyyy")</small>
</div>}</div>
</div>
</div>
<div class="row g-4 mb-4 align-items-start">
<div class="col-xl-7 col-lg-6">
<div class="card project-section-card">
<div class="card-header project-section-header">
<strong>
<i class="bi bi-chat-square-text me-2">
</i>Updates</strong>
</div>
<div class="card-body">
<div class="mb-3"><label class="form-label">Current status</label><select class="form-select" @bind="newPostStatus"><option>Pending</option><option>On Track</option><option>At Risk</option><option>Off Track</option><option>Completed</option><option>Paused</option><option>Cancelled</option></select></div>
<textarea class="form-control mb-2" @bind="newPostMessage" placeholder="Post an update for the project...">
</textarea>
<button class="btn btn-primary" @onclick="AddPostAsync">Post update</button>
</div>
<div class="list-group list-group-flush">@foreach(var post in project.Posts.OrderByDescending(post => post.CreatedAt)){<div class="list-group-item">
<strong>@post.Author</strong>
<div class="small text-muted">@post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>@if(editingPostId == post.Id){<div class="input-group my-2">
<input class="form-control" @bind="editPostMessage" />
<button class="btn btn-primary" @onclick="SavePostAsync">Save</button>
<button class="btn btn-outline-secondary" @onclick="CancelPostEdit">Cancel</button>
</div>}else{<div class="my-2">@post.Message</div>}<div class="d-flex justify-content-between align-items-center">
<div class="d-flex gap-1">
<button class="btn btn-sm btn-outline-secondary" @onclick='() => ReactAsync(post.Id, "👍")'>👍 @post.Reactions.Count(reaction => reaction.Emoji == "👍")</button>
</div>
<span>
<button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BeginPostEdit(post)">
<i class="bi bi-pencil">
</i>
</button>
<button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePostAsync(post.Id)">
<i class="bi bi-trash">
</i>
</button>
</span>
</div>
<div class="d-none">
<button class="btn btn-sm btn-outline-secondary" @onclick='() => ReactAsync(post.Id, "👍")'>👍 @post.Reactions.Count(reaction => reaction.Emoji == "👍")</button>
</div>@foreach(var comment in post.Comments.OrderBy(comment => comment.CreatedAt)){<div class="small border-start ps-2 mt-2">@if(editingCommentId == comment.Id){<div class="input-group input-group-sm">
<input class="form-control" @bind="editCommentMessage" />
<button class="btn btn-primary" @onclick="SaveCommentAsync">Save</button>
<button class="btn btn-outline-secondary" @onclick="CancelCommentEdit">Cancel</button>
</div>}else{<div class="d-flex justify-content-between gap-2">
<span>
<strong>@comment.Author:</strong> @comment.Message</span>
<span class="text-nowrap">
<button class="btn btn-sm btn-link p-0 me-2" @onclick="() => BeginCommentEdit(comment)">
<i class="bi bi-pencil">
</i>
</button>
<button class="btn btn-sm btn-link text-danger p-0" @onclick="() => DeleteCommentAsync(comment.Id)">
<i class="bi bi-trash">
</i>
</button>
</span>
</div>}</div>}<div class="input-group input-group-sm mt-2">
<input class="form-control" value="@GetCommentMessage(post.Id)" @oninput="eventArgs => commentMessages[post.Id] = eventArgs.Value?.ToString() ?? string.Empty" placeholder="Add a comment..." />
<button class="btn btn-outline-primary" @onclick="() => AddCommentAsync(post.Id)">Comment</button>
</div>
</div>}@if(!project.Posts.Any()){<div class="list-group-item text-muted">No updates have been posted yet.</div>}</div>
</div>
<ProjectTimeline ProjectId="@project.Id" />
</div>
<div class="col-xl-5 col-lg-6">
<div class="card project-details-card">
<div class="card-header project-details-header">
<div class="project-details-icon">
<i class="bi bi-card-list">
</i>
</div>
<div>
<strong>Project Details</strong>
<div class="small">Project information, target date and roles</div>
</div>
</div>
<div class="card-body">
<div class="mb-3">
<label class="form-label">Project title</label>
<InputText class="form-control" @bind-Value="project.Name" />
</div>
<div class="mb-3">
<label class="form-label">Description</label>
<InputTextArea class="form-control" @bind-Value="project.Description" />
</div>
<div class="mb-3">
<label class="form-label">Project owner</label>
<InputText class="form-control" @bind-Value="project.Owner" />
</div>
<div class="row g-3 mb-3">
<div class="col-md-6">
<label class="form-label">Project lead</label>
<InputText class="form-control" @bind-Value="project.ProjectLead" />
</div>
<div class="col-md-6">
<label class="form-label">Developer</label>
<InputText class="form-control" @bind-Value="project.Developer" />
</div>
</div>
<div class="mb-3">
<label class="form-label">Target date</label>
<InputDate class="form-control" @bind-Value="project.TargetDate" />
</div>
<button class="btn btn-primary mb-4" @onclick="SaveTargetDateAsync">Save project details</button>
<div class="project-roles-heading">
<i class="bi bi-people me-2">
</i>
<strong>Roles</strong>
</div>
<div class="input-group mb-3">
<input class="form-control" @bind="newRoleName" placeholder="Role" />
<input class="form-control" @bind="newRolePerson" placeholder="Person" />
<button class="btn btn-primary" @onclick="AddRoleAsync">Add</button>
</div>@foreach(var role in project.Roles){<div class="project-role-row">@if(editingRoleId == role.Id){<div class="input-group input-group-sm">
<input class="form-control" @bind="editRoleName" />
<input class="form-control" @bind="editRolePerson" />
<button class="btn btn-primary" @onclick="SaveRoleAsync">Save</button>
<button class="btn btn-outline-secondary" @onclick="CancelRoleEdit">Cancel</button>
</div>}else{<div class="d-flex justify-content-between align-items-center">
<span>
<strong>@role.RoleName</strong>
<span class="text-muted"> · @role.PersonName</span>
</span>
<span>
<button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BeginRoleEdit(role)">
<i class="bi bi-pencil">
</i>
</button>
<button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRoleAsync(role.Id)">
<i class="bi bi-trash">
</i>
</button>
</span>
</div>}</div>}</div>
</div>
</div>
</div>
<div class="card project-section-card mb-4 d-none">
<div class="card-header project-section-header">
<strong>
<i class="bi bi-signpost-split me-2">
</i>Project Timeline</strong>
</div>
<div class="card-body">
<div class="row g-4">
<div class="col-lg-4">
<div class="project-subsection-heading">
<i class="bi bi-plus-circle me-2">
</i>
<strong>Add to timeline</strong>
</div>
<EditForm Model="newUpdate" OnValidSubmit="AddUpdateAsync">
<DataAnnotationsValidator />
<div class="mb-3">
<label class="form-label">Type</label>
<InputSelect class="form-select" @bind-Value="newUpdate.Kind">
<option>Update</option>
<option>Milestone</option>
<option>Risk</option>
<option>Decision</option>
</InputSelect>
</div>
<div class="mb-3">
<label class="form-label">Details</label>
<InputTextArea class="form-control" @bind-Value="newUpdate.Message" />
<ValidationMessage For="@(() => newUpdate.Message)" />
</div>
<button class="btn btn-primary" type="submit">Add to timeline</button>
</EditForm>
</div>
<div class="col-lg-8">
<div class="project-subsection-heading">
<i class="bi bi-clock-history me-2">
</i>
<strong>Timeline entries</strong>
</div>
<div class="project-timeline">@foreach (var item in project.Updates.OrderByDescending(item => item.CreatedAt)) { <div class="project-timeline-item">
<div class="d-flex align-items-center gap-2">
<i class="bi @KindIcon(item.Kind) fs-5" title="@item.Kind">
</i>
<span class="badge @KindClass(item.Kind)">@item.Kind</span>
</div>@if(editingUpdateId == item.Id) { <div class="mt-2">
<select class="form-select form-select-sm mb-2" @bind="editKind">
<option>Update</option>
<option>Milestone</option>
<option>Risk</option>
<option>Decision</option>
</select>
<textarea class="form-control form-control-sm" @bind="editMessage">
</textarea>
<div class="mt-2">
<button class="btn btn-sm btn-primary me-2" @onclick="SaveTimelineEntryAsync">Save</button>
<button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
</div>
</div> } else { <div class="mt-2">@item.Message</div> }<div class="small text-muted mt-1 d-flex justify-content-between align-items-center">
<span>@item.Author · @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
<span>
<button type="button" class="btn btn-sm btn-outline-secondary me-1" title="Edit timeline entry" @onclick="() => BeginEdit(item)">
<i class="bi bi-pencil">
</i>
</button>
<button type="button" class="btn btn-sm btn-outline-danger" title="Delete timeline entry" @onclick="() => DeleteTimelineEntryAsync(item.Id)">
<i class="bi bi-trash">
</i>
</button>
</span>
</div>
</div> }</div>
</div>
</div>
<div class="project-risks-section mt-4">
<div class="project-subsection-heading">
<i class="bi bi-exclamation-diamond me-2">
</i>
<strong>Key risks and decisions</strong>
</div>
<div class="list-group list-group-flush">@foreach (var item in KeyItems) { <div class="list-group-item">
<span class="badge @(item.Kind == "Risk" ? "text-bg-danger" : "text-bg-info") me-2">@item.Kind</span>@item.Message<div class="small text-muted mt-1 d-flex justify-content-between align-items-center">
<span>@item.Author · @item.CreatedAt.ToString("dd/MM/yyyy")</span>
<button type="button" class="btn btn-sm btn-outline-danger" title="Delete timeline entry" @onclick="() => DeleteTimelineEntryAsync(item.Id)">
<i class="bi bi-trash">
</i>
</button>
</div>
</div> } @if (!KeyItems.Any()) { <div class="list-group-item text-muted">No risks or decisions recorded.</div> }</div>
</div>
</div>
</div>
}
@code { [Parameter] public int Id { get; set; } private Project? project; private string currentUser = string.Empty; private UpdateInput newUpdate = new(); private bool confirmDelete, showImagePicker; private string newPostMessage = string.Empty, newPostStatus = "Pending", newRoleName = string.Empty, newRolePerson = string.Empty; private Dictionary<int, string> commentMessages = new(); private int? editingUpdateId, editingCommentId, editingPostId, editingRoleId; private string editPostMessage = string.Empty, editRoleName = string.Empty, editRolePerson = string.Empty; private string editCommentMessage = string.Empty; private string editKind = "Update", editMessage = string.Empty; private IEnumerable<ProjectUpdate> KeyItems => project is null ? Enumerable.Empty<ProjectUpdate>() : project.Updates.Where(item => item.Kind is "Risk" or "Decision").OrderByDescending(item => item.CreatedAt); protected override async Task OnInitializedAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var user = await UserManager.GetUserAsync(state.User); currentUser = user?.DisplayName ?? user?.Email ?? ""; project = await ProjectService.GetAsync(Id); } private async Task AddUpdateAsync() { if (project is null) return; await ProjectService.AddUpdateAsync(project.Id, newUpdate.Kind, newUpdate.Message, currentUser); project = await ProjectService.GetAsync(Id); newUpdate = new(); } private void BeginEdit(ProjectUpdate item) { editingUpdateId = item.Id; editKind = item.Kind; editMessage = item.Message; } private void CancelEdit() { editingUpdateId = null; } private async Task SaveTimelineEntryAsync() { if (project is null || editingUpdateId is not int updateId) return; if (await ProjectService.UpdateUpdateAsync(project.Id, updateId, editKind, editMessage)) { project = await ProjectService.GetAsync(Id); editingUpdateId = null; } } private async Task UploadImageAsync(InputFileChangeEventArgs args) { if (project is null) return; var file = args.File; var extension = Path.GetExtension(file.Name).ToLowerInvariant(); if (file.Size > 5 * 1024 * 1024 || extension is not ".png" and not ".jpg" and not ".jpeg" and not ".webp") return; var folder = Path.Combine(Environment.WebRootPath, "uploads", "project-images"); Directory.CreateDirectory(folder); var fileName = Guid.NewGuid().ToString("N") + extension; await using var output = File.Create(Path.Combine(folder, fileName)); await using var input = file.OpenReadStream(5 * 1024 * 1024); await input.CopyToAsync(output); await ProjectService.UpdateImageAsync(project.Id, fileName); project = await ProjectService.GetAsync(Id); showImagePicker = false; } private string GetCommentMessage(int postId) => commentMessages.TryGetValue(postId, out var message) ? message : string.Empty; private async Task AddPostAsync() { if (project is null) return; await ProjectService.AddPostAsync(project.Id, newPostMessage, currentUser, newPostStatus); project = await ProjectService.GetAsync(Id); newPostMessage = string.Empty; } private async Task AddCommentAsync(int postId) { if (project is null || !commentMessages.TryGetValue(postId, out var message)) return; await ProjectService.AddCommentAsync(postId, message, currentUser); project = await ProjectService.GetAsync(Id); commentMessages[postId] = string.Empty; } private void BeginPostEdit(ProjectPost post) { editingPostId = post.Id; editPostMessage = post.Message; } private void CancelPostEdit() { editingPostId = null; } private async Task SavePostAsync() { if (editingPostId is not int postId) return; await ProjectService.UpdatePostAsync(postId, editPostMessage); project = await ProjectService.GetAsync(Id); CancelPostEdit(); } private async Task DeletePostAsync(int postId) { await ProjectService.DeletePostAsync(postId); project = await ProjectService.GetAsync(Id); } private void BeginCommentEdit(ProjectPostComment comment) { editingCommentId = comment.Id; editCommentMessage = comment.Message; } private void CancelCommentEdit() { editingCommentId = null; editCommentMessage = string.Empty; } private async Task SaveCommentAsync() { if (editingCommentId is not int commentId) return; await ProjectService.UpdateCommentAsync(commentId, editCommentMessage); project = await ProjectService.GetAsync(Id); CancelCommentEdit(); } private async Task DeleteCommentAsync(int commentId) { await ProjectService.DeleteCommentAsync(commentId); project = await ProjectService.GetAsync(Id); } private async Task ReactAsync(int postId, string emoji) { if (project is null) return; await ProjectService.ToggleReactionAsync(postId, currentUser, emoji); project = await ProjectService.GetAsync(Id); } private async Task SaveTargetDateAsync() { if (project is null) return; await ProjectService.UpdateDetailsAsync(project); project = await ProjectService.GetAsync(Id); } private void BeginRoleEdit(ProjectRole role) { editingRoleId = role.Id; editRoleName = role.RoleName; editRolePerson = role.PersonName; } private void CancelRoleEdit() { editingRoleId = null; } private async Task SaveRoleAsync() { if (editingRoleId is not int roleId) return; await ProjectService.UpdateRoleAsync(roleId, editRoleName, editRolePerson); project = await ProjectService.GetAsync(Id); CancelRoleEdit(); } private async Task AddRoleAsync() { if (project is null) return; await ProjectService.AddRoleAsync(project.Id, newRoleName, newRolePerson); project = await ProjectService.GetAsync(Id); newRoleName = newRolePerson = string.Empty; } private async Task DeleteRoleAsync(int roleId) { if (project is null) return; await ProjectService.DeleteRoleAsync(roleId); project = await ProjectService.GetAsync(Id); } private async Task DeleteTimelineEntryAsync(int updateId) { if (project is null) return; if (await ProjectService.DeleteUpdateAsync(project.Id, updateId)) project = await ProjectService.GetAsync(Id); } private async Task DeleteAsync() { if (project is null) return; if (await ProjectService.DeleteAsync(project.Id)) Navigation.NavigateTo("projects"); } private static string KindIcon(string kind) => kind switch { "Milestone" => "bi-flag", "Risk" => "bi-exclamation-triangle", "Decision" => "bi-check-circle", _ => "bi-arrow-repeat" }; private static string KindClass(string kind) => kind switch { "Risk" => "text-bg-danger", "Decision" => "text-bg-info", "Milestone" => "text-bg-success", _ => "text-bg-primary" }; private static string StatusClass(string status) => status switch { "On Track" or "Completed" or "Complete" => "text-bg-success", "At Risk" or "On Hold" => "text-bg-warning", "Off Track" or "Cancelled" => "text-bg-danger", "Paused" => "text-bg-info", "In Progress" => "text-bg-primary", _ => "text-bg-secondary" }; private sealed class UpdateInput { public string Kind { get; set; } = "Update"; [Required] public string Message { get; set; } = string.Empty; } }


















