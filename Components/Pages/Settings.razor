@page "/settings"
@rendermode InteractiveServer

@using ServicePortal.Models
@using ServicePortal.Data
@using ServicePortal.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject SettingsService SettingsService
@inject IConfiguration Configuration

<PageTitle>Settings</PageTitle>

<div class="settings-page">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Settings</h1>
            <p class="text-muted mb-0">Configure your Service Portal preferences.</p>
        </div>

        <button class="btn btn-primary" @onclick="SaveSettings">
            Save Settings
        </button>
    </div>

    <!-- Success Message -->
    @if (showSavedMessage)
    {
        <div class="alert alert-success d-flex align-items-center mb-4">
            <span class="me-2">✓</span>
            Settings saved successfully.
        </div>
    }

    <BrandingSettings />

    <div class="settings-section-title"><i class="bi bi-sliders"></i><div><h2>Module Preferences</h2><p>Set the defaults and display options for the modules you use.</p></div></div>

    <AuthorizeView Policy="TicketsModule">
        <Authorized>
    <!-- Support Tickets settings -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Appearance</h5>
        </div>

        <div class="card-body">

            <div class="row align-items-center pb-4 mb-4 border-bottom">
                <div class="col-md-8">
                    <label class="fw-semibold">Portal Theme</label>
                    <div class="text-muted small">Choose the colour palette you would like to use. This only changes your own view.</div>
                </div>
                <div class="col-md-4">
                    <select class="form-select" @bind="settings.Theme">
                        <option value="SgsLight">SGS Light</option>
                        <option value="SlateDark">Slate Dark</option>
                        <option value="IndigoLight">Indigo Light</option>
                        <option value="MidnightBlue">Midnight Blue</option>
                        <option value="WarmNeutral">Warm Neutral</option>
                        <option value="RoseLight">Rose Light</option>
                    </select>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-md-8">
                    <label class="fw-semibold">
                        Ticket List Layout
                    </label>

                    <div class="text-muted small">
                        Choose how much information is displayed in ticket lists.
                    </div>
                </div>

                <div class="col-md-4">
                    <select class="form-select"
                            @bind="settings.TicketLayout">

                        <option value="Comfortable">Comfortable</option>
                        <option value="Compact">Compact</option>

                    </select>
                </div>
            </div>

        </div>
    </div>

    <!-- Ticket Defaults -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Ticket Defaults</h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Default Priority
                    </label>

                    <select class="form-select"
                            @bind="settings.DefaultPriority">

                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>

                    </select>

                    <div class="form-text">
                        Default priority for new tickets.
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Default Category
                    </label>

                    <select class="form-select"
                            @bind="settings.DefaultCategory">

                        <option value="eCERT">eCERT</option>
                        <option value="eGTA">eGTA</option>
                        <option value="eCONSIGN">eCONSIGN</option>
                        <option value="UKCS Portal">UKCS Portal</option>

                    </select>

                    <div class="form-text">
                        Default category for new tickets.
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Tickets Per Page
                    </label>

                    <select class="form-select"
                            @bind="settings.TicketsPerPage">

                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>

                    </select>

                    <div class="form-text">
                        Number of tickets displayed on ticket lists.
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Ticket Behaviour -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Ticket Behaviour</h5>
        </div>

        <div class="card-body">

            <div class="row align-items-center mb-4">

                <div class="col-md-9">
                    <label class="fw-semibold">
                        Confirm Before Deleting
                    </label>

                    <div class="text-muted small">
                        Ask for confirmation before permanently deleting a ticket.
                    </div>
                </div>

                <div class="col-md-3 text-md-end">
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="settings.ConfirmDelete" />
                    </div>
                </div>

            </div>

            <div class="row align-items-center mb-4">

                <div class="col-md-9">
                    <label class="fw-semibold">
                        Confirm Before Closing
                    </label>

                    <div class="text-muted small">
                        Ask for confirmation before closing a ticket.
                    </div>
                </div>

                <div class="col-md-3 text-md-end">
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="settings.ConfirmClose" />
                    </div>
                </div>

            </div>

            <div class="row align-items-center mb-4">

                <div class="col-md-9">
                    <label class="fw-semibold">
                        Automatically Refresh Tickets
                    </label>

                    <div class="text-muted small">
                        Automatically refresh ticket lists when new activity occurs.
                    </div>
                </div>

                <div class="col-md-3 text-md-end">
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="settings.AutoRefresh" />
                    </div>
                </div>

            </div>

            <div class="row align-items-center">

                <div class="col-md-9">
                    <label class="fw-semibold">
                        Remember My Settings
                    </label>

                    <div class="text-muted small">
                        Save your preferences in this browser.
                    </div>
                </div>

                <div class="col-md-3 text-md-end">
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="settings.RememberSettings" />
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Notifications -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Notifications</h5>
        </div>

        <div class="card-body">

            <div class="row align-items-center mb-4">

                <div class="col-md-9">
                    <label class="fw-semibold">
                        Enable Notifications
                    </label>

                    <div class="text-muted small">
                        Show notifications when ticket activity occurs.
                    </div>
                </div>

                <div class="col-md-3 text-md-end">
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="settings.NotificationsEnabled" />
                    </div>
                </div>

            </div>

            <div class="row align-items-center mb-4">

                <div class="col-md-9">
                    <label class="fw-semibold">
                        New Ticket Notifications
                    </label>

                    <div class="text-muted small">
                        Notify when a new ticket is created.
                    </div>
                </div>

                <div class="col-md-3 text-md-end">
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="settings.NewTicketNotifications" />
                    </div>
                </div>

            </div>

            <div class="row align-items-center">

                <div class="col-md-9">
                    <label class="fw-semibold">
                        Assignment Notifications
                    </label>

                    <div class="text-muted small">
                        Notify when a ticket is assigned to you.
                    </div>
                </div>

                <div class="col-md-3 text-md-end">
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="settings.AssignmentNotifications" />
                    </div>
                </div>

            </div>

        </div>
    </div>

        </Authorized>
    </AuthorizeView>

    <!-- User Preferences -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">User Preferences</h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Display Name
                    </label>

                    <input class="form-control"
                           @bind="settings.DisplayName"
                           placeholder="Enter your name" />

                    <div class="form-text">
                        Name displayed within the helpdesk.
                    </div>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Default Landing Page
                    </label>

                    <select class="form-select"
                            @bind="settings.DefaultLandingPage">

                        <option value="Dashboard">
                            Dashboard
                        </option>

                        <AuthorizeView Policy="TicketsModule">
                            <Authorized>
                                <option value="OpenTickets">Open Tickets</option>
                                <option value="ClosedTickets">Closed Tickets</option>
                                <option value="Reports">Reports</option>
                            </Authorized>
                        </AuthorizeView>

                    </select>

                    <div class="form-text">
                        Page shown when opening the helpdesk.
                    </div>

                </div>

            </div>

        </div>
    </div>

    <AuthorizeView Policy="OnboardingModule">
        <Authorized>
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5 class="mb-0">Customer Onboarding</h5></div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Default go-live lead time</label>
                            <select class="form-select" @bind="settings.OnboardingDefaultGoLiveDays">
                                <option value="14">14 days</option><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option>
                            </select>
                            <div class="form-text">Used when starting a new customer onboarding.</div>
                        </div>
                        <div class="col-md-6">
                            <div class="settings-switch-row">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" @bind="settings.OnboardingShowCompleted" />
                            </div>
                            <div>
                                <label class="form-check-label fw-semibold">Show completed onboardings</label>
                                <div class="form-text">Keep completed customer implementations visible in the list.</div>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="TestingModule">
        <Authorized>
            <div class="settings-section-title"><i class="bi bi-clipboard2-check"></i><div><h2>Quality Assurance</h2><p>Set defaults for releases and test checks.</p></div></div>
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5 class="mb-0">Testing</h5></div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Default software</label>
                            <select class="form-select" @bind="settings.TestingDefaultSoftware">
                                <option value="eCERT">eCERT</option><option value="eGTA">eGTA</option><option value="Brokerage Portal">Brokerage Portal</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Default live-date lead time</label>
                            <select class="form-select" @bind="settings.TestingDefaultLiveDateDays">
                                <option value="3">3 days</option><option value="7">7 days</option><option value="14">14 days</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <div class="settings-switch-row">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" @bind="settings.TestingSecondTesterByDefault" />
                            </div>
                            <div>
                                    <label class="form-check-label fw-semibold">Require two testers by default</label>
                                    <div class="form-text">Applied to new release points.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="TicketsModule">
        <Authorized>
    <!-- Support Tickets dashboard -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Dashboard</h5>
        </div>

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-9">

                    <label class="fw-semibold">
                        Show Recent Tickets
                    </label>

                    <div class="text-muted small">
                        Display the recent tickets table on the dashboard.
                    </div>

                </div>

                <div class="col-md-3 text-md-end">

                    <div class="form-check form-switch d-inline-block">

                        <input class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="settings.ShowRecentTickets" />

                    </div>

                </div>

            </div>

        </div>
    </div>

        </Authorized>
    </AuthorizeView>

    <div class="settings-section-title"><i class="bi bi-book"></i><div><h2>Knowledge Base</h2><p>Manage the software and subcategories available when creating support articles.</p></div></div>
    <KnowledgeBaseConfiguration />

    <div class="settings-section-title"><i class="bi bi-database"></i><div><h2>Data Management</h2><p>Export information and reset saved preferences.</p></div></div>

    <!-- Data Management -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Data Management</h5>
        </div>

        <div class="card-body">

            <p class="text-muted">
                Manage your data and settings.
            </p>

            <div class="d-flex gap-2 flex-wrap">

                <AuthorizeView Policy="TicketsModule">
                    <Authorized>
                        <button class="btn btn-outline-secondary" @onclick="ExportData">Export Tickets</button>
                    </Authorized>
                </AuthorizeView>

                <button class="btn btn-outline-danger"
                        @onclick="ResetSettings">

                    Reset Settings

                </button>

            </div>

        </div>
    </div>

    <!-- Release Notes -->
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-megaphone me-2"></i>Release Notes</h5>
            <span class="badge text-bg-primary">v@ReleaseVersion</span>
        </div>
        <div class="card-body">
            <div class="fw-semibold mb-2">Latest release · @ReleaseDate</div>
            <ul class="mb-0 ps-3">
                @foreach (var change in ReleaseChanges)
                {
                    <li class="mb-1">@change</li>
                }
            </ul>
        </div>
    </div>


    <!-- About -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">About</h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <strong>Application</strong>

                    <div class="text-muted">
                        Service Portal
                    </div>

                </div>

                <div class="col-md-6">

                    <strong>Version</strong>

                    <div class="text-muted">
                        @ReleaseVersion
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

@code
{
    private string ReleaseVersion =>
        Configuration["ReleaseNotes:Version"] ?? "1.0.0";

    private string ReleaseDate =>
        Configuration["ReleaseNotes:Date"] ?? "Not recorded";

    private string[] ReleaseChanges =>
        Configuration.GetSection("ReleaseNotes:Changes").Get<string[]>()
        ?? ["No release notes have been added."];
    private AppSettings settings = new();

    private bool showSavedMessage = false;


protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        await SettingsService.LoadAsync();

        settings = SettingsService.Current;

        await SettingsService.ApplyAppearanceAsync();

        StateHasChanged();
    }
}

private async Task SaveSettings()
{
    SettingsService.Update(settings);

    if (settings.RememberSettings)
    {
        await SettingsService.SaveAsync();
    }
    else
    {
        await SettingsService.ResetAsync();
    }

    await SettingsService.ApplyAppearanceAsync();

    showSavedMessage = true;
}

private async Task ResetSettings()
{
    await SettingsService.ResetAsync();

    settings = SettingsService.Current;

    await SettingsService.ApplyAppearanceAsync();

    showSavedMessage = true;
}

    private async Task ExportData()
    {
        await Task.CompletedTask;
    }

}

