@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using ServicePortal.Data
@using ServicePortal.Services
@inject ProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<div class="card project-section-card mt-4">
    <div class="card-header project-section-header"><strong><i class="bi bi-signpost-split me-2"></i>Project Timeline</strong></div>
    <div class="card-body">
        <div class="project-subsection-heading"><i class="bi bi-plus-circle me-2"></i><strong>Add to timeline</strong></div>
        <EditForm Model="newUpdate" OnValidSubmit="AddAsync"><DataAnnotationsValidator />
            <div class="mb-3"><label class="form-label">Type</label><InputSelect class="form-select" @bind-Value="newUpdate.Kind"><option>Update</option><option>Milestone</option><option>Risk</option><option>Decision</option></InputSelect></div>
            <div class="mb-3"><label class="form-label">Details</label><InputTextArea class="form-control" @bind-Value="newUpdate.Message" /><ValidationMessage For="@(() => newUpdate.Message)" /></div>
            <button class="btn btn-primary" type="submit">Add to timeline</button>
        </EditForm>
        <div class="project-subsection-heading mt-4"><i class="bi bi-clock-history me-2"></i><strong>Timeline entries</strong></div>
        @if (updates.Count == 0) { <div class="text-muted">No timeline entries have been added.</div> }
        else { @foreach (var item in updates) { <div class="project-timeline-item"><div class="d-flex align-items-center gap-2"><i class="bi @KindIcon(item.Kind) fs-5"></i><span class="badge @KindClass(item.Kind)">@item.Kind</span></div>@if (editingId == item.Id) { <div class="mt-2"><select class="form-select form-select-sm mb-2" @bind="editKind"><option>Update</option><option>Milestone</option><option>Risk</option><option>Decision</option></select><textarea class="form-control form-control-sm" @bind="editMessage"></textarea><div class="mt-2"><button class="btn btn-sm btn-primary me-2" @onclick="SaveEditAsync">Save</button><button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button></div></div> } else { <div class="mt-2">@item.Message</div> }<div class="small text-muted mt-1 d-flex justify-content-between align-items-center"><span>@item.Author · @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span><span><button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BeginEdit(item)"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item.Id)"><i class="bi bi-trash"></i></button></span></div></div> } }
    </div>
</div>

@code {
    [Parameter] public int ProjectId { get; set; }
    private List<ProjectUpdate> updates = [];
    private string currentUser = string.Empty;
    private TimelineInput newUpdate = new();
    private int? editingId;
    private string editKind = "Update", editMessage = string.Empty;
    protected override async Task OnParametersSetAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var user = await UserManager.GetUserAsync(state.User); currentUser = user?.DisplayName ?? user?.Email ?? "User"; await LoadAsync(); }
    private async Task LoadAsync() => updates = (await ProjectService.GetAsync(ProjectId))?.Updates.OrderByDescending(item => item.CreatedAt).ToList() ?? [];
    private async Task AddAsync() { await ProjectService.AddUpdateAsync(ProjectId, newUpdate.Kind, newUpdate.Message, currentUser); newUpdate = new(); await LoadAsync(); }
    private void BeginEdit(ProjectUpdate item) { editingId = item.Id; editKind = item.Kind; editMessage = item.Message; }
    private void CancelEdit() => editingId = null;
    private async Task SaveEditAsync() { if (editingId is int id && await ProjectService.UpdateUpdateAsync(ProjectId, id, editKind, editMessage)) { editingId = null; await LoadAsync(); } }
    private async Task DeleteAsync(int id) { if (await ProjectService.DeleteUpdateAsync(ProjectId, id)) await LoadAsync(); }
    private static string KindIcon(string kind) => kind switch { "Milestone" => "bi-flag", "Risk" => "bi-exclamation-triangle", "Decision" => "bi-check-circle", _ => "bi-arrow-repeat" };
    private static string KindClass(string kind) => kind switch { "Risk" => "text-bg-danger", "Decision" => "text-bg-info", "Milestone" => "text-bg-success", _ => "text-bg-primary" };
    private sealed class TimelineInput { public string Kind { get; set; } = "Update"; [Required] public string Message { get; set; } = string.Empty; }
}
