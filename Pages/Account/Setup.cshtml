@page "/Account/Setup"
@model ServicePortal.Pages.Account.SetupModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Initial Setup - SGS Helpdesk</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/app.css" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: #f4f6f8;
        }

        .setup-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        .setup-container {
            width: 100%;
            max-width: 480px;
        }

        .setup-card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.10);
            padding: 40px;
        }

        .setup-logo {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo-block {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f58220;
            color: #ffffff;
            font-size: 28px;
            font-weight: 700;
            padding: 12px 22px;
            border-radius: 6px;
            margin-bottom: 18px;
        }

        .setup-logo h1 {
            font-size: 24px;
            font-weight: 600;
            margin: 0;
        }

        .setup-logo p {
            color: #6c757d;
            margin-top: 6px;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            min-height: 46px;
        }

        .setup-button {
            width: 100%;
            min-height: 46px;
            font-weight: 600;
            background: #f58220;
            border-color: #f58220;
        }

        .setup-button:hover {
            background: #d96f12;
            border-color: #d96f12;
        }

        .info-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 25px;
            font-size: 14px;
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper .form-control {
            padding-right: 45px;
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #6c757d;
            cursor: pointer;
        }
    </style>
</head>

<body>

<div class="setup-page">

    <div class="setup-container">

        <div class="setup-card">

            <div class="setup-logo">

                <div class="logo-block">
                    SGS
                </div>

                <h1>Helpdesk Setup</h1>

                <p>Create the first administrator account</p>

            </div>

            <div class="info-box">

                <i class="bi bi-shield-lock me-2"></i>

                This account will have full administrator access to
                the SGS Helpdesk application.

            </div>

<form method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger"
         role="alert">
    </div>

                <div class="mb-3">

                    <label asp-for="DisplayName"
                           class="form-label">
                        Display name
                    </label>

                    <input asp-for="DisplayName"
                           class="form-control"
                           placeholder="e.g. Ben Lear"
                           autocomplete="name" />

                    <span asp-validation-for="DisplayName"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        Email address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email address"
                           autocomplete="username" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <div class="password-wrapper">

                        <input asp-for="Password"
                               id="password"
                               class="form-control"
                               placeholder="Create a password"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword()"
                                aria-label="Show password">

                            <i id="passwordIcon"
                               class="bi bi-eye">
                            </i>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Minimum 8 characters, including uppercase,
                        lowercase and a number.
                    </div>

                </div>

                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                        Confirm password
                    </label>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Confirm your password"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary setup-button">

                    <i class="bi bi-person-plus me-2"></i>
                    Create Administrator

                </button>

            </form>

        </div>

    </div>

</div>

<script>
    function togglePassword() {

        const password = document.getElementById("password");
        const icon = document.getElementById("passwordIcon");

        if (password.type === "password") {

            password.type = "text";

            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");

        } else {

            password.type = "password";

            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");

        }
    }
</script>

</body>
</html>
