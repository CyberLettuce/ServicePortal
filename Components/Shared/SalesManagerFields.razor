@using ServicePortal.Data
@code { [Parameter, EditorRequired] public CustomerOnboarding Model { get; set; } = default!; [Parameter] public bool IncludeSalesManager { get; set; } = true; [Parameter] public bool RequireSalesOwner { get; set; } }
@if (IncludeSalesManager) { <div class="col-md-6"><label class="form-label">Sales Manager</label><InputSelect class="form-select" @bind-Value="Model.SalesManager"><option value="">Select sales manager</option><option>Adam Ware</option><option>Andy Maber</option><option>Austin Jennings</option><option>Bruce Yeung</option><option>Darren Jackson</option><option>Ian James</option></InputSelect></div> }
<div class="col-md-6"><label class="form-label">Sales Owner</label><InputSelect class="@(RequireSalesOwner && string.IsNullOrWhiteSpace(Model.SalesOwner) ? "form-select missing-field" : "form-select")" @bind-Value="Model.SalesOwner"><option value="">Select sales owner</option><option>Adam Ware</option><option>Andy Maber</option><option>Austin Jennings</option><option>Bruce Yeung</option><option>Darren Jackson</option><option>Ian James</option></InputSelect></div>
