@page "/opentickets"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using ServicePortal.Services
@attribute [Authorize(Policy = "TicketsModule")]
@rendermode InteractiveServer
@inject TicketService TicketService
@inject NavigationManager Navigation

<PageHeader Title="Open Tickets" Description="Tickets that still require attention."><Actions><button class="btn btn-outline-secondary" @onclick="RefreshAsync"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button><button class="btn btn-primary" @onclick='()=>Navigation.NavigateTo("tickets/new")'><i class="bi bi-plus-lg me-1"></i>Create Ticket</button></Actions></PageHeader>
@if(tickets.Count == 0){<div class="alert alert-info">There are no open tickets.</div>}
else {
<div class="card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-3"><label class="form-label">Search</label><input class="form-control" @bind="search" @bind:event="oninput" placeholder="Number, description or user" /></div><div class="col-md-3"><label class="form-label">Priority</label><select class="form-select" @bind="priorityFilter"><option value="">All priorities</option>@foreach(var value in Priorities){<option>@value</option>}</select></div><div class="col-md-3"><label class="form-label">Category</label><select class="form-select" @bind="categoryFilter"><option value="">All categories</option>@foreach(var value in Categories){<option>@value</option>}</select></div><div class="col-md-3"><label class="form-label">Assigned To</label><select class="form-select" @bind="assignedFilter"><option value="">All users</option>@foreach(var value in Assignees){<option>@value</option>}</select></div></div><div class="d-flex gap-2 align-items-end mt-3"><div><label class="form-label">Set selected tickets to</label><select class="form-select" @bind="bulkStatus"><option>Open</option><option>Closed</option></select></div><button class="btn btn-outline-primary" @onclick="ApplyBulkStatusAsync" disabled="@(selected.Count == 0)">Update @selected.Count selected</button></div></div></div>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th><input type="checkbox" checked="@AllFilteredSelected" @onchange="ToggleAll" aria-label="Select all" /></th><th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("No")'>No</button></th><th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Description")'>Description</button></th><th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Priority")'>Priority</button></th><th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Category")'>Category</button></th><th><button class="btn btn-link p-0 text-reset" @onclick='()=>SortBy("Assigned")'>Assigned To</button></th></tr></thead><tbody>@foreach(var ticket in FilteredTickets){<tr class="ticket-row" @onclick='@(() => Navigation.NavigateTo("ticket/" + ticket.TicketNumber))'><td @onclick:stopPropagation="true"><input type="checkbox" checked="@selected.Contains(ticket.TicketNumber)" @onchange="()=>ToggleSelected(ticket.TicketNumber)" /></td><td>@(string.IsNullOrWhiteSpace(ticket.TicketReference)?$"#{ticket.TicketNumber}":ticket.TicketReference)</td><td>@ticket.Description</td><td>@ticket.Priority</td><td>@ticket.Category</td><td>@ticket.AssignedTo</td></tr>}</tbody></table></div>}
@code { private List<ServicePortal.Models.Ticket> tickets=[]; [SupplyParameterFromQuery(Name="priority")] public string? QueryPriority {get;set;} private string search="",priorityFilter="",categoryFilter="",assignedFilter="",bulkStatus="Open",sortColumn="No"; private bool sortAscending=false; private HashSet<int> selected=[]; private IEnumerable<string> Priorities=>tickets.Select(x=>x.Priority).Distinct().Order(); private IEnumerable<string> Categories=>tickets.Select(x=>x.Category).Distinct().Order(); private IEnumerable<string> Assignees=>tickets.Select(x=>x.AssignedTo).Distinct().Order(); private IEnumerable<ServicePortal.Models.Ticket> FilteredTickets {get {var items=tickets.Where(x=>(priorityFilter==""||x.Priority==priorityFilter)&&(categoryFilter==""||x.Category==categoryFilter)&&(assignedFilter==""||x.AssignedTo==assignedFilter)&&(string.IsNullOrWhiteSpace(search)||x.Description.Contains(search,StringComparison.OrdinalIgnoreCase)||x.TicketReference.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Category.Contains(search,StringComparison.OrdinalIgnoreCase)||x.AssignedTo.Contains(search,StringComparison.OrdinalIgnoreCase))); return(sortColumn,sortAscending)switch{("Description",true)=>items.OrderBy(x=>x.Description),("Description",false)=>items.OrderByDescending(x=>x.Description),("Priority",true)=>items.OrderBy(x=>x.Priority),("Priority",false)=>items.OrderByDescending(x=>x.Priority),("Category",true)=>items.OrderBy(x=>x.Category),("Category",false)=>items.OrderByDescending(x=>x.Category),("Assigned",true)=>items.OrderBy(x=>x.AssignedTo),("Assigned",false)=>items.OrderByDescending(x=>x.AssignedTo),("No",true)=>items.OrderBy(x=>x.TicketNumber),_=>items.OrderByDescending(x=>x.TicketNumber)};}} private bool AllFilteredSelected=>FilteredTickets.Any()&&FilteredTickets.All(x=>selected.Contains(x.TicketNumber)); protected override async Task OnInitializedAsync(){await RefreshAsync();priorityFilter=QueryPriority??"";} private async Task RefreshAsync(){await TicketService.LoadAsync();tickets=TicketService.GetTickets().Where(x=>x.Status=="Open").ToList();} private void SortBy(string value){if(sortColumn==value)sortAscending=!sortAscending;else{sortColumn=value;sortAscending=true;}} private void ToggleSelected(int id){if(!selected.Add(id))selected.Remove(id);} private void ToggleAll(){if(AllFilteredSelected)foreach(var ticket in FilteredTickets)selected.Remove(ticket.TicketNumber);else foreach(var ticket in FilteredTickets)selected.Add(ticket.TicketNumber);} private async Task ApplyBulkStatusAsync(){await TicketService.UpdateTicketStatusesAsync(selected,bulkStatus);selected.Clear();await RefreshAsync();} }
