@page "/users"

@using System.ComponentModel.DataAnnotations
@using ServicePortal.Data
@using ServicePortal.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Policy = "AdministratorOnly")]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject AuditLogService AuditLogService
@inject ModuleAccessService ModuleAccessService

<PageHeader Title="User Management" Description="Manage user access, roles, and modules.">
    <Actions><button type="button" class="btn btn-primary" @onclick="ShowCreateUser"><i class="bi bi-person-plus me-1"></i>Create User</button></Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (showCreateUser)
{
<div class="card mt-4">
    <div class="card-header">
        <strong>Create user</strong>
    </div>

    <div class="card-body">

        <EditForm Model="@newUser"
                  OnValidSubmit="CreateUserAsync">

            <DataAnnotationsValidator />

            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label class="form-label">
                    Display name
                </label>

                <InputText @bind-Value="newUser.DisplayName"
                           class="form-control"
                           placeholder="e.g. Ben Lear" />

                <ValidationMessage For="@(() => newUser.DisplayName)" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Email address
                </label>

                <InputText @bind-Value="newUser.Email"
                           class="form-control"
                           type="email"
                           placeholder="Enter email address" />

                <ValidationMessage For="@(() => newUser.Email)" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Password
                </label>

                <InputText @bind-Value="newUser.Password"
                           class="form-control"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Enter password" />

                <ValidationMessage For="@(() => newUser.Password)" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Confirm password
                </label>

                <InputText @bind-Value="newUser.ConfirmPassword"
                           class="form-control"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Confirm password" />

                <ValidationMessage For="@(() => newUser.ConfirmPassword)" />
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Role
                </label>

                <InputSelect @bind-Value="newUser.Role"
                             class="form-select">

                    <option value="">
                        Select a role
                    </option>

                    <option value="Administrator">
                        Administrator
                    </option>

                    <option value="Support">
                        Support
                    </option>

                    <option value="ReadOnly">
                        Read Only
                    </option>

                </InputSelect>

                <ValidationMessage For="@(() => newUser.Role)" />
            </div>

            <div class="form-check form-switch mb-4">
                <InputCheckbox @bind-Value="newUser.TicketsModuleEnabled"
                               class="form-check-input" />
                <label class="form-check-label">
                    Support Tickets module
                </label>
                <div class="form-text">
                    Gives this user access to ticket pages and reports.
                </div>
            </div>

            <div class="form-check form-switch mb-4">
                <InputCheckbox @bind-Value="newUser.OnboardingModuleEnabled"
                               class="form-check-input" />
                <label class="form-check-label">
                    Customer Onboarding module
                </label>
                <div class="form-text">
                    Gives this user access to customer onboarding records and checklists.
                </div>
            </div>

            <div class="form-check form-switch mb-4">
                <InputCheckbox @bind-Value="newUser.TestingModuleEnabled" class="form-check-input" />
                <label class="form-check-label">Testing module</label>
                <div class="form-text">Gives this user access to testing schedules and results.</div>
            </div>

            <div class="form-check form-switch mb-4">
                <InputCheckbox @bind-Value="newUser.ProjectsModuleEnabled" class="form-check-input" />
                <label class="form-check-label">Projects module</label>
                <div class="form-text">Gives this user access to project delivery and updates.</div>
            </div>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@isCreating">

                @if (isCreating)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status">
                    </span>

                    <span>Creating...</span>
                }
                else
                {
                    <i class="bi bi-person-plus me-2"></i>
                    <span>Create User</span>
                }

            </button>

        </EditForm>

    </div>
</div>
}

