@page "/existing-customers"
@rendermode InteractiveServer
@using ServicePortal.Data
@using ServicePortal.Services
@using ServicePortal.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "OnboardingModule")]
@inject ExistingCustomerService ExistingCustomerService
@inject ChamberService ChamberService
@inject NavigationManager Navigation
<PageHeader Title="Existing Customers" Description="Maintain customer and software details after onboarding."><Actions><button class="btn btn-primary" @onclick="NewCustomer"><i class="bi bi-plus-lg me-1"></i>New Customer</button></Actions></PageHeader>
@if(editing is not null){<div class="card ticket-details-surface mb-4"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-buildings"></i><div><strong>@(editing.Id == 0 ? "Add existing customer" : "Edit existing customer")</strong><div class="small">Customer and software details, without an onboarding checklist.</div></div></div></div><div class="card-body"><div class="row g-3"><div class="col-md-6"><label>Company Name</label><input class="form-control" @bind="editing.CustomerName" /></div><div class="col-md-6"><label>Status</label><select class="form-select" @bind="editing.Status"><option>Active</option><option>Inactive</option></select></div><div class="col-md-6"><label>Company Contact</label><input class="form-control" @bind="editing.ContactName" /></div><div class="col-md-6"><label>Contact Email</label><input class="form-control" @bind="editing.ContactEmail" /></div><div class="col-md-6"><label>Software / package purchased</label><OnboardingProductSelector @bind-Value="editing.ProductsPurchased" /></div>@if(IsEcert){<div class="col-md-6"><label>Chamber of Commerce</label><select class="form-select" @bind="editing.ChamberOfCommerce"><option value="">Select a chamber</option>@foreach(var chamber in chambers){<option value="@chamber">@chamber</option>}</select></div><div class="col-12"><label>Documents</label><div class="ticket-egta-options"><div class="ticket-egta-options-grid">@foreach(var option in EcertOptions){<label class="ticket-egta-option @(IsDocumentSelected(option) ? "selected" : "")"><input type="checkbox" class="form-check-input" checked="@IsDocumentSelected(option)" @onchange="()=>ToggleDocument(option)" /><span>@option</span></label>}</div></div></div><div class="col-md-6"><label>Languages Required</label><select class="form-select" @bind="editing.LanguagesRequired"><option value=""></option><option>English</option><option>Portuguese</option><option>Other</option></select></div>}@if(IsEgta){<div class="col-md-6"><label>Project No.</label><input class="form-control" @bind="editing.ProjectNumber" /></div>}<div class="col-md-6"><label>Go-Live Date</label><input class="form-control" type="date" @bind="editing.GoLiveDate" /></div><div class="col-md-6"><label>Renewal Date</label><input class="form-control" type="date" @bind="editing.RenewalDate" /></div><div class="col-md-6"><label>Sales Manager</label><select class="form-select" @bind="editing.SalesManager"><option value=""></option><option>Adam Ware</option><option>Andy Maber</option><option>Austin Jennings</option><option>Bruce Yeung</option><option>Darren Jackson</option><option>Ian James</option></select></div><div class="col-md-6"><label>Implementation Owner</label><input class="form-control" @bind="editing.ImplementationOwner" /></div><div class="col-md-6 d-flex align-items-end"><div class="form-check mb-2"><input id="voc-completed" class="form-check-input" type="checkbox" @bind="editing.VocCompleted" /><label class="form-check-label" for="voc-completed">VOC Completed</label></div></div>@if(editing.VocCompleted){<div class="col-md-6"><label>Contact Name</label><input class="form-control mb-3" @bind="editing.VocContactName" /><label>Date Completed</label><input class="form-control" type="date" @bind="editing.VocCompletedDate" /></div><div class="col-md-6"><label>Feedback</label><textarea class="form-control" rows="5" @bind="editing.Feedback" placeholder="Add customer feedback"></textarea></div>}</div><div class="mt-4"><button class="btn btn-primary me-2" @onclick="SaveAsync">Save Customer</button><button class="btn btn-outline-secondary" @onclick="()=>editing=null">Cancel</button></div></div></div>}
<div class="card ticket-details-surface"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-people"></i><div><strong>Customer records</strong><div class="small">Select a customer to view their linked support tickets.</div></div></div></div><div class="card-body border-bottom"><div class="row g-3"><div class="col-lg-4"><label class="form-label">Search customers</label><input class="form-control" placeholder="Search project no., company or contact" @bind="searchTerm" @bind:event="oninput" /></div><div class="col-lg-3"><label class="form-label">Filter by Software</label><select class="form-select" @bind="softwareFilter"><option value="">All software</option>@foreach(var software in SoftwareOptions){<option value="@software">@software</option>}</select></div><div class="col-lg-2"><label class="form-label">Status</label><select class="form-select" @bind="statusFilter"><option value="">All statuses</option>@foreach(var status in StatusOptions){<option value="@status">@status</option>}</select></div><div class="col-lg-3"><label class="form-label">Go-Live Date</label><input type="date" class="form-control" @bind="goLiveFilter" /></div></div></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick="ToggleProjectSort">Project No. @(projectAscending ? "↑" : "↓")</button></th><th><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick="ToggleCompanySort">Company @(companyAscending ? "↑" : "↓")</button></th><th>Software</th><th>Contact</th><th>Status</th><th><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick="ToggleGoLiveSort">Go-Live @(goLiveNewestFirst ? "↓" : "↑")</button></th><th></th></tr></thead><tbody>@if(FilteredCustomers.Count()==0){<tr><td colspan="7" class="text-muted">No customers match this filter.</td></tr>}@foreach(var customer in FilteredCustomers){<tr style="cursor:pointer" @onclick="()=>Open(customer.Id)"><td>@customer.ProjectNumber</td><td><strong>@customer.CustomerName</strong></td><td>@customer.ProductsPurchased</td><td>@customer.ContactName</td><td><span class="badge @(customer.Status=="Active" ? "text-bg-success" : "text-bg-secondary")">@customer.Status</span></td><td>@(customer.GoLiveDate?.ToString("dd/MM/yyyy") ?? "Not set")</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Edit(customer)" @onclick:stopPropagation="true">Edit</button></td></tr>}</tbody></table></div></div>
@code { [SupplyParameterFromQuery(Name="edit")] public int? EditId {get;set;} private static readonly string[] EcertOptions=["Arab Certificate of Origin","ATA Carnet","EU Certificate of Origin","EUR1","EUR-MED","International Import Certificate","UK Certificate of Origin"]; private List<ExistingCustomer> customers=[]; private List<string> chambers=[]; private ExistingCustomer? editing; private string softwareFilter=string.Empty, statusFilter=string.Empty, searchTerm=string.Empty; private DateTime? goLiveFilter; private bool goLiveNewestFirst=true, sortByGoLive=false, sortByProject=false, projectAscending=true, sortByCompany=true, companyAscending=true; private IEnumerable<string> SoftwareOptions=>customers.SelectMany(customer=>customer.ProductsPurchased.Split(new[]{',',';'},StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries)).Distinct(StringComparer.OrdinalIgnoreCase).Order(); private IEnumerable<string> StatusOptions=>customers.Select(customer=>customer.Status).Where(status=>!string.IsNullOrWhiteSpace(status)).Distinct().Order(); private IEnumerable<ExistingCustomer> FilteredCustomers=>(sortByGoLive ? (goLiveNewestFirst ? customers.OrderByDescending(customer=>customer.GoLiveDate) : customers.OrderBy(customer=>customer.GoLiveDate)) : sortByProject ? (projectAscending ? customers.OrderBy(customer=>customer.ProjectNumber) : customers.OrderByDescending(customer=>customer.ProjectNumber)) : (companyAscending ? customers.OrderBy(customer=>customer.CustomerName) : customers.OrderByDescending(customer=>customer.CustomerName))).Where(customer=>(string.IsNullOrWhiteSpace(softwareFilter)||customer.ProductsPurchased.Split(new[]{',',';'},StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).Any(item=>string.Equals(item,softwareFilter,StringComparison.OrdinalIgnoreCase)))&&(string.IsNullOrWhiteSpace(statusFilter)||string.Equals(customer.Status,statusFilter,StringComparison.OrdinalIgnoreCase))&&(!goLiveFilter.HasValue||customer.GoLiveDate.HasValue&&customer.GoLiveDate.Value.Date==goLiveFilter.Value.Date)&&(string.IsNullOrWhiteSpace(searchTerm)||new[]{customer.ProjectNumber,customer.CustomerName,customer.ContactName,customer.ContactEmail,customer.ProductsPurchased}.Any(value=>value.Contains(searchTerm,StringComparison.OrdinalIgnoreCase)))); protected override async Task OnInitializedAsync(){customers=await ExistingCustomerService.GetAllAsync();chambers=await ChamberService.GetNamesAsync();if(EditId is int id){var item=customers.FirstOrDefault(customer=>customer.Id==id);if(item is not null)Edit(item);}} private bool IsEcert=>editing is not null&&OnboardingProductCatalog.Parse(editing.ProductsPurchased).Products.Contains("eCERT"); private bool IsEgta=>editing is not null&&OnboardingProductCatalog.Parse(editing.ProductsPurchased).Products.Contains("eGTA"); private bool IsDocumentSelected(string option)=>editing?.Documents.Split(";",StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).Contains(option)==true; private void ToggleDocument(string option){if(editing is null)return;var values=editing.Documents.Split(";",StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).ToHashSet();if(!values.Add(option))values.Remove(option);editing.Documents=string.Join("; ",EcertOptions.Where(values.Contains));} private void NewCustomer()=>editing=new ExistingCustomer(); private void Edit(ExistingCustomer x)=>editing=new ExistingCustomer{Id=x.Id,CustomerName=x.CustomerName,ContactName=x.ContactName,ContactEmail=x.ContactEmail,ProductsPurchased=x.ProductsPurchased,SoftwareDetails=x.SoftwareDetails,ImplementationOwner=x.ImplementationOwner,ClientNumber=x.ClientNumber,ChamberOfCommerce=x.ChamberOfCommerce,Documents=x.Documents,LanguagesRequired=x.LanguagesRequired,ProjectNumber=x.ProjectNumber,SalesManager=x.SalesManager,GoLiveDate=x.GoLiveDate,RenewalDate=x.RenewalDate,VocCompleted=x.VocCompleted,Feedback=x.Feedback,VocContactName=x.VocContactName,VocCompletedDate=x.VocCompletedDate,Status=x.Status}; private async Task SaveAsync(){if(editing is null||string.IsNullOrWhiteSpace(editing.CustomerName))return;await ExistingCustomerService.SaveAsync(editing);editing=null;customers=await ExistingCustomerService.GetAllAsync();} private void ToggleGoLiveSort(){if(sortByGoLive)goLiveNewestFirst=!goLiveNewestFirst;else{sortByGoLive=true;sortByProject=false;sortByCompany=false;}} private void ToggleProjectSort(){if(sortByProject)projectAscending=!projectAscending;else{sortByProject=true;sortByGoLive=false;sortByCompany=false;}} private void ToggleCompanySort(){if(sortByCompany)companyAscending=!companyAscending;else{sortByCompany=true;sortByProject=false;sortByGoLive=false;}} private void Open(int id)=>Navigation.NavigateTo("existing-customers/"+id); }











