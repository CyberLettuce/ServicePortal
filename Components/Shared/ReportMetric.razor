<div class="col-sm-6 col-xl-3">
    <div class="card h-100 report-metric @(OnClick.HasDelegate ? "report-metric-link" : "")" @onclick="OnClick">
        <div class="card-body d-flex justify-content-between align-items-start">
            <div>
                <div class="text-muted small text-uppercase fw-semibold">@Label</div>
                <div class="display-6 fw-semibold mt-2 mb-0">@Value</div>
            </div>
            <span class="report-metric-icon text-bg-@Accent">
                <i class="bi @Icon" aria-hidden="true"></i>
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public object? Value { get; set; }

    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Accent { get; set; } = "primary";

    [Parameter]
    public EventCallback OnClick { get; set; }
}
