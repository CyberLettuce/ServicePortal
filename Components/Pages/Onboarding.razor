@page "/onboarding"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using ServicePortal.Data
@using ServicePortal.Services
@using ServicePortal.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@attribute [Authorize(Policy = "OnboardingModule")]

@inject OnboardingService OnboardingService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject SettingsService SettingsService

<PageHeader Title="Current Onboarding" Description="Manage new customers from order confirmation through to go-live.">
    <Actions>
        <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise me-2"></i>Refresh</button>
        <button type="button" class="btn btn-primary" @onclick="ToggleCreateForm">
            <i class="bi @(showCreateForm ? "bi-x-lg" : "bi-plus-lg") me-2"></i>@(showCreateForm ? "Cancel" : "New Customer")
        </button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (showCreateForm)
{
    <div class="card onboarding-create-card mb-4">
        <div class="card-header">
            <strong>Add a customer onboarding</strong>
        </div>
        <div class="card-body">
            <EditForm Model="newOnboarding" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="onboarding-product-fields h-100">
                            <div class="onboarding-product-fields-heading"><i class="bi bi-buildings"></i><div><strong>Customer Details</strong><div class="text-muted small">Company and contact information</div></div></div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Status</label>
                                <InputSelect class="form-select" @bind-Value="newOnboarding.Status"><option>Not Started</option><option>In Progress</option><option>Complete</option></InputSelect>
                            </div>
                            <div class="col-12">
                                <label class="form-label">@(IsEcert(newOnboarding) ? "Chamber of Commerce" : "Company Name")</label>
                                <InputText class="form-control" required @bind-Value="newOnboarding.CustomerName" />
                                <ValidationMessage For="@(() => newOnboarding.CustomerName)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">@(IsEcert(newOnboarding) ? "Chamber Contact" : "Company Contact")</label>
                                <InputText class="form-control" required @bind-Value="newOnboarding.ContactName" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">@(IsEcert(newOnboarding) ? "Chamber Email" : "Contact email")</label>
                                <InputText class="form-control" required type="email" @bind-Value="newOnboarding.ContactEmail" />
                                <ValidationMessage For="@(() => newOnboarding.ContactEmail)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Implementation owner</label>
                                <InputSelect class="form-select" @bind-Value="newOnboarding.ImplementationOwner">
                                    <option value="">Select an owner</option>
                                    @foreach (var owner in implementationOwners) { <option value="@owner">@owner</option> }
                                </InputSelect>
                            </div>
                        </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">Software / package purchased</label>
                        <OnboardingProductSelector @bind-Value="newOnboarding.ProductsPurchased" Onboarding="newOnboarding" />
                        <ValidationMessage For="@(() => newOnboarding.ProductsPurchased)" />
                    </div>
                    <div class="col-12"><OnboardingConditionalFields Model="newOnboarding" /></div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="newOnboarding.Notes" />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isCreating">
                        @if (isCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Create Onboarding
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="p-5 text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="text-muted mt-2">Loading customer onboardings...</div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card onboarding-stat-card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">Active</div>
                    <div class="display-6 fw-bold">@ActiveCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card onboarding-stat-card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">Completed</div>
                    <div class="display-6 fw-bold text-success">@CompletedCount</div>
                </div>
            </div>
        </div>
    </div>

    @if (onboardings.Count == 0)
    {
        <div class="card">
            <div class="card-body p-5 text-center">
                <div class="dashboard-empty-icon mx-auto mb-3">
                    <i class="bi bi-person-plus"></i>
                </div>
                <h2 class="h4">No customer onboardings yet</h2>
                <p class="text-muted mb-3">
                    Add the first customer to begin tracking their route to go-live.
                </p>
                <button class="btn btn-primary" @onclick="ToggleCreateForm">
                    New Customer
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <span class="fw-semibold me-2">Filter customers</span>
                @foreach (var product in ProductFilters)
                {
                    <button type="button" class="btn @(selectedProduct == product ? "btn-primary" : "btn-outline-primary")" @onclick="() => selectedProduct = product">@(product == "All" ? "All" : product)</button>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Customers</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick='() => SortBy("company")'>Company @SortIcon("company")</button></th>
                            <th><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick='() => SortBy("software")'>Software @SortIcon("software")</button></th>
                            <th><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick='() => SortBy("owner")'>Owner @SortIcon("owner")</button></th>
                            <th><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick='() => SortBy("golive")'>Go-live @SortIcon("golive")</button></th>
                            <th><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick='() => SortBy("status")'>Status @SortIcon("status")</button></th>
                            <th style="min-width: 190px;"><button class="btn btn-link p-0 text-decoration-none text-reset fw-semibold" @onclick='() => SortBy("progress")'>Progress @SortIcon("progress")</button></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var onboarding in FilteredOnboardings)
                        {
                            <tr style="cursor: pointer;" @onclick="() => Open(onboarding.Id)">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (onboarding.ImageContent is { Length: > 0 }) { <img src="onboarding-images/@onboarding.Id" alt="" class="rounded border" style="width: 38px; height: 38px; object-fit: cover;" /> }
                                        <div><strong>@onboarding.CustomerName</strong><div class="text-muted small">@onboarding.OnboardingReference</div>@if (!string.IsNullOrWhiteSpace(onboarding.ContactName)) { <div class="text-muted small">@onboarding.ContactName</div> }</div>
                                    </div>
                                </td>
                                <td>@onboarding.ProductsPurchased</td>
                                <td>@DisplayValue(onboarding.ImplementationOwner)</td>
                                <td class="text-nowrap">@onboarding.TargetGoLiveDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @StatusBadge(onboarding.Status)">
                                        @onboarding.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar bg-success"
                                                 style="@($"width: {onboarding.ProgressPercent}%")"></div>
                                        </div>
                                        <span class="small text-muted">@onboarding.ProgressPercent%</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => Open(onboarding.Id)">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<CustomerOnboarding> onboardings = new();
    private CustomerOnboarding newOnboarding = CreateDefaultOnboarding();
    private List<string> implementationOwners = new();
    private bool isLoading = true;
    private bool isCreating;
    private bool showCreateForm;
    private string selectedProduct = "All";
    private string sortColumn = "company";
    private bool sortAscending = true;
    private string? successMessage;
    private string? errorMessage;

    private int ActiveCount => onboardings.Count(item => item.Status != "Complete");
    private int CompletedCount => onboardings.Count(item => item.Status == "Complete");
    private static readonly string[] ProductFilters = ["All", "Brokerage Portal", "eCERT", "eGTA", "TransitNet"];
    private static bool IsEcert(CustomerOnboarding onboarding) => OnboardingProductCatalog.Parse(onboarding.ProductsPurchased).Products.Contains("eCERT");
    private IEnumerable<CustomerOnboarding> FilteredOnboardings => Sort(selectedProduct == "All"
        ? onboardings
        : onboardings.Where(item => OnboardingProductCatalog.Parse(item.ProductsPurchased).Products.Contains(selectedProduct)));

    protected override async Task OnInitializedAsync()
    {
        await SettingsService.LoadAsync();

        implementationOwners =
            await OnboardingService.GetImplementationOwnersAsync();

        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var currentUser =
            await UserManager.GetUserAsync(authState.User);

        var defaultOwner = currentUser?.DisplayName ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(defaultOwner) &&
            !implementationOwners.Contains(defaultOwner))
        {
            implementationOwners.Add(defaultOwner);
            implementationOwners = implementationOwners
                .OrderBy(owner => owner)
                .ToList();
        }

        newOnboarding = CreateDefaultOnboarding(
            defaultOwner,
            SettingsService.Current.OnboardingDefaultGoLiveDays);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        onboardings = await OnboardingService.GetAllAsync();
        if (!SettingsService.Current.OnboardingShowCompleted)
        {
            onboardings = onboardings
                .Where(item => item.Status != "Complete")
                .ToList();
        }
        isLoading = false;
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        errorMessage = null;
    }

    private async Task CreateAsync()
    {
        errorMessage = null;
        successMessage = null;

        var requiredErrors = OnboardingService.GetRequiredFieldErrors(newOnboarding);
        if (requiredErrors.Count > 0)
        {
            errorMessage = string.Join(" ", requiredErrors);
            return;
        }

        if (newOnboarding.TargetGoLiveDate < newOnboarding.StartDate)
        {
            errorMessage = "The target go-live date cannot be before the start date.";
            return;
        }

        isCreating = true;

        try
        {
            await OnboardingService.CreateAsync(newOnboarding);
            successMessage =
                $"Onboarding {newOnboarding.OnboardingReference} created for " +
                $"{newOnboarding.CustomerName}.";
            newOnboarding = CreateDefaultOnboarding(
                newOnboarding.ImplementationOwner,
                SettingsService.Current.OnboardingDefaultGoLiveDays);
            showCreateForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"The onboarding could not be created: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    private void Open(int id) => Navigation.NavigateTo($"onboarding/{id}");

    private void SortBy(string column)
    {
        if (sortColumn == column) sortAscending = !sortAscending;
        else { sortColumn = column; sortAscending = true; }
    }

    private IEnumerable<CustomerOnboarding> Sort(IEnumerable<CustomerOnboarding> values)
    {
        Func<CustomerOnboarding, object> key = sortColumn switch
        {
            "software" => item => item.ProductsPurchased,
            "owner" => item => item.ImplementationOwner,
            "golive" => item => item.TargetGoLiveDate,
            "status" => item => item.Status,
            "progress" => item => item.ProgressPercent,
            _ => item => item.CustomerName
        };
        return sortAscending ? values.OrderBy(key) : values.OrderByDescending(key);
    }

    private string SortIcon(string column) => sortColumn != column ? "↕" : sortAscending ? "↑" : "↓";

    private static string DisplayValue(string value) =>
        string.IsNullOrWhiteSpace(value) ? "Unassigned" : value;

    private static string StatusBadge(string status) => status switch
    {
        "Complete" => "bg-success",
        "Blocked" => "bg-danger",
        "In Progress" => "bg-primary",
        _ => "bg-secondary"
    };

    private static CustomerOnboarding CreateDefaultOnboarding(
        string implementationOwner = "",
        int goLiveDays = 30) => new()
    {
        ImplementationOwner = implementationOwner,
        StartDate = DateTime.Today,
        TargetGoLiveDate = DateTime.Today.AddDays(goLiveDays)
    };
}






