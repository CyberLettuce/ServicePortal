@using ServicePortal.Data
@using ServicePortal.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "SupportOrAdministrator")]
@inject KnowledgeBaseService KnowledgeBaseService

<div class="card shadow-sm mb-4"><div class="card-header"><strong>Software and subcategories</strong></div><div class="card-body"><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label">Software</label><input class="form-control" @bind="model.Software" placeholder="e.g. eCERT" /></div><div class="col-md-5"><label class="form-label">Subcategory</label><input class="form-control" @bind="model.Subcategory" placeholder="Leave blank for no subcategory" /></div><div class="col-md-2"><label class="form-label">Order</label><input class="form-control" type="number" @bind="model.SortOrder" /></div><div class="col-md-1"><button class="btn btn-primary w-100" @onclick="SaveAsync">Save</button></div></div><div class="list-group mt-4">@foreach(var item in options){<div class="list-group-item d-flex justify-content-between align-items-center"><span><strong>@item.Software</strong>@if(!string.IsNullOrWhiteSpace(item.Subcategory)){<span class="text-muted"> · @item.Subcategory</span>}</span><div class="btn-group"><button class="btn btn-sm btn-outline-primary" @onclick="()=>Edit(item)">Edit</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>DeleteAsync(item.Id)">Delete</button></div></div>}</div></div></div>
@code { private List<KnowledgeBaseSoftwareOption> options=[]; private KnowledgeBaseSoftwareOption model=new(); protected override async Task OnInitializedAsync()=>await LoadAsync(); private async Task LoadAsync()=>options=await KnowledgeBaseService.GetSoftwareOptionsAsync(); private void Edit(KnowledgeBaseSoftwareOption item)=>model=new KnowledgeBaseSoftwareOption{Id=item.Id,Software=item.Software,Subcategory=item.Subcategory,SortOrder=item.SortOrder}; private async Task SaveAsync(){if(string.IsNullOrWhiteSpace(model.Software))return;await KnowledgeBaseService.SaveSoftwareOptionAsync(model);model=new();await LoadAsync();} private async Task DeleteAsync(int id){await KnowledgeBaseService.DeleteSoftwareOptionAsync(id);await LoadAsync();} }
