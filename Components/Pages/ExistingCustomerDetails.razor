@page "/existing-customers/{Id:int}"
@rendermode InteractiveServer
@using ServicePortal.Data
@using ServicePortal.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "OnboardingModule")]
@inject ExistingCustomerService ExistingCustomerService
@inject NavigationManager Navigation
@if(customer is null){<div class="alert alert-info">Loading customer...</div>}else{<PageHeader Title="@(string.IsNullOrWhiteSpace(customer.ProjectNumber) ? customer.CustomerName : customer.ProjectNumber + " · " + customer.CustomerName)" Description="Existing customer details and linked tickets."><Actions><button class="btn btn-primary" @onclick='()=>Navigation.NavigateTo("existing-customers?edit=" + customer.Id)'><i class="bi bi-pencil me-1"></i>Edit Customer</button><button class="btn btn-outline-secondary" @onclick='()=>Navigation.NavigateTo("existing-customers")'>Back to Existing Customers</button><button class="btn btn-outline-danger" @onclick="DeleteAsync">Delete Customer</button></Actions></PageHeader><div class="row g-4"><div class="col-lg-6"><div class="card ticket-details-surface"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-buildings"></i><div><strong>Customer Details</strong><div class="small">Company and contact information</div></div></div></div><div class="card-body"><p><strong>Company Contact</strong><br />@customer.ContactName</p><p><strong>Contact Email</strong><br />@customer.ContactEmail</p><p><strong>Implementation Owner</strong><br />@customer.ImplementationOwner</p><p><strong>Status</strong><br />@customer.Status</p><p><strong>VOC Completed</strong><br />@(customer.VocCompleted ? "Yes" : "No")</p>@if(customer.VocCompleted){<p><strong>VOC Contact Name</strong><br />@customer.VocContactName</p><p><strong>Date Completed</strong><br />@(customer.VocCompletedDate?.ToString("dd/MM/yyyy") ?? "Not set")</p><p class="mb-0"><strong>Feedback</strong><br />@customer.Feedback</p>}</div></div></div><div class="col-lg-6"><div class="card ticket-details-surface"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-box-seam"></i><div><strong>Software Details</strong><div class="small">Products and customer software information</div></div></div></div><div class="card-body"><p><strong>Software</strong><br />@customer.ProductsPurchased</p><p><strong>Project No.</strong><br />@customer.ProjectNumber</p><p><strong>Go-Live Date</strong><br />@(customer.GoLiveDate?.ToString("dd/MM/yyyy") ?? "Not set")</p><p class="mb-0"><strong>Renewal Date</strong><br />@(customer.RenewalDate?.ToString("dd/MM/yyyy") ?? "Not set")</p></div></div></div></div><div class="card ticket-details-surface mt-4"><div class="card-header"><div class="ticket-details-heading"><i class="bi bi-ticket-detailed"></i><div><strong>Linked Tickets</strong><div class="small">Tickets assigned to this existing customer.</div></div></div></div><div class="list-group list-group-flush">@if(tickets.Count==0){<div class="list-group-item text-muted">No tickets are linked to this customer.</div>}@foreach(var ticket in tickets){<button class="list-group-item list-group-item-action" @onclick='()=>Navigation.NavigateTo("ticket/"+ticket.TicketNumber)'><strong>@ticket.TicketReference</strong> · @ticket.Description</button>}</div></div>}
@code { [Parameter] public int Id {get;set;} private ExistingCustomer? customer; private List<ServicePortal.Models.Ticket> tickets=[]; protected override async Task OnParametersSetAsync(){customer=await ExistingCustomerService.GetAsync(Id);tickets=await ExistingCustomerService.GetTicketsAsync(Id);} private async Task DeleteAsync(){await ExistingCustomerService.DeleteAsync(Id);Navigation.NavigateTo("existing-customers");} }






