@code
{
    private string? currentUserId;
    private CreateUserModel newUser = new();

    private string? successMessage;
    private string? errorMessage;

    private bool isCreating;

    private bool showCreateUser;

    private void ShowCreateUser()
    {
        successMessage = null;
        errorMessage = null;
        newUser = new CreateUserModel();
        showCreateUser = true;
    }
    private List<UserListItem> users = new();

    private bool isLoadingUsers = true;

protected override async Task OnInitializedAsync()
{
    var authState =
        await AuthenticationStateProvider.GetAuthenticationStateAsync();

    var currentUser =
        await UserManager.GetUserAsync(authState.User);

    currentUserId = currentUser?.Id;

    await LoadUsersAsync();
}

private async Task LoadUsersAsync()
{
    isLoadingUsers = true;

    try
    {
        users.Clear();

        var ticketModuleUserIds =
            await ModuleAccessService.GetUserIdsAsync(
                ModuleKeys.Tickets);

        var onboardingModuleUserIds =
            await ModuleAccessService.GetUserIdsAsync(
                ModuleKeys.Onboarding);

        var testingModuleUserIds =
            await ModuleAccessService.GetUserIdsAsync(
                ModuleKeys.Testing);
        var projectsModuleUserIds = await ModuleAccessService.GetUserIdsAsync(ModuleKeys.Projects);

        foreach (var user in UserManager.Users.ToList())
        {
            var roles =
                await UserManager.GetRolesAsync(user);

            users.Add(new UserListItem
            {
                Id = user.Id,
                DisplayName = user.DisplayName ?? string.Empty,
                Email = user.Email ?? string.Empty,
                Role = roles.FirstOrDefault() ?? "No Role",
                TicketsModuleEnabled =
                    ticketModuleUserIds.Contains(user.Id),
                OnboardingModuleEnabled =
                    onboardingModuleUserIds.Contains(user.Id),
                TestingModuleEnabled =
                    testingModuleUserIds.Contains(user.Id),
                ProjectsModuleEnabled = projectsModuleUserIds.Contains(user.Id),
                IsLockedOut =
                    user.LockoutEnd.HasValue &&
                    user.LockoutEnd.Value > DateTimeOffset.UtcNow
            });
        }

        users = users
            .OrderBy(user => user.DisplayName)
            .ToList();
    }
    finally
    {
        isLoadingUsers = false;
    }
}

    private async Task CreateUserAsync()
    {
        successMessage = null;
        errorMessage = null;
        isCreating = true;

        try
        {
            var email = newUser.Email.Trim();
            var displayName = newUser.DisplayName.Trim();

            var existingUser =
                await UserManager.FindByEmailAsync(email);

            if (existingUser is not null)
            {
                errorMessage =
                    "A user with this email address already exists.";

                return;
            }

            var roleExists =
                await RoleManager.RoleExistsAsync(newUser.Role);

            if (!roleExists)
            {
                errorMessage =
                    "The selected role does not exist.";

                return;
            }

            var user = new ApplicationUser
            {
                UserName = email,
                Email = email,
                DisplayName = displayName,
                EmailConfirmed = true
            };

            var createResult =
                await UserManager.CreateAsync(
                    user,
                    newUser.Password);

            if (!createResult.Succeeded)
            {
                errorMessage = string.Join(
                    " ",
                    createResult.Errors.Select(
                        error => error.Description));

                return;
            }

            var roleResult =
                await UserManager.AddToRoleAsync(
                    user,
                    newUser.Role);

            if (!roleResult.Succeeded)
            {
                // Don't leave a partially created user
                // if the role assignment fails.
                await UserManager.DeleteAsync(user);

                errorMessage = string.Join(
                    " ",
                    roleResult.Errors.Select(
                        error => error.Description));

                return;
            }

            await ModuleAccessService.SetAccessAsync(
                user.Id,
                ModuleKeys.Tickets,
                newUser.TicketsModuleEnabled);

            await ModuleAccessService.SetAccessAsync(
                user.Id,
                ModuleKeys.Onboarding,
                newUser.OnboardingModuleEnabled);

            await ModuleAccessService.SetAccessAsync(
                user.Id,
                ModuleKeys.Testing,
                newUser.TestingModuleEnabled);
            await ModuleAccessService.SetAccessAsync(user.Id, ModuleKeys.Projects, newUser.ProjectsModuleEnabled);

            await AuditLogService.RecordAsync(
                "User created",
                user.Id,
                user.Email,
                $"Created user with role {newUser.Role}. " +
                $"Support Tickets: " +
                $"{(newUser.TicketsModuleEnabled ? "enabled" : "disabled")}. " +
                $"Customer Onboarding: " +
                $"{(newUser.OnboardingModuleEnabled ? "enabled" : "disabled")}. " +
                $"Testing: {(newUser.TestingModuleEnabled ? "enabled" : "disabled")}. " +
                $"Projects: {(newUser.ProjectsModuleEnabled ? "enabled" : "disabled")}.");

successMessage =
    $"{displayName} has been created as {newUser.Role}.";

newUser = new CreateUserModel();
showCreateUser = false;

await LoadUsersAsync();
        }
        finally
        {
            isCreating = false;
        }
    }

    private sealed class CreateUserModel
    {
        [Required(
            ErrorMessage = "Please enter a display name.")]
        [StringLength(100)]
        public string DisplayName { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Please enter an email address.")]
        [EmailAddress(
            ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Please enter a password.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Please confirm the password.")]
        [DataType(DataType.Password)]
        [Compare(
            nameof(Password),
            ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Please select a role.")]
        public string Role { get; set; } = string.Empty;

        public bool TicketsModuleEnabled { get; set; } = true;

        public bool OnboardingModuleEnabled { get; set; }

        public bool TestingModuleEnabled { get; set; }
        public bool ProjectsModuleEnabled { get; set; }
    }

    private sealed class UserListItem
{
    public string Id { get; set; } = string.Empty;

    public string DisplayName { get; set; } = string.Empty;

    public string Email { get; set; } = string.Empty;

    public string Role { get; set; } = string.Empty;

    public bool TicketsModuleEnabled { get; set; }

    public bool OnboardingModuleEnabled { get; set; }

    public bool TestingModuleEnabled { get; set; }
    public bool ProjectsModuleEnabled { get; set; }

    public bool IsLockedOut { get; set; }
}

private UserListItem? editingUser;

private EditUserModel editUserModel = new();

private bool isSavingUser;

private UserListItem? passwordResetUser;

private PasswordResetModel passwordResetModel = new();

private bool isResettingPassword;

private UserListItem? deletingUser;

private bool isDeletingUser;

private void BeginEdit(UserListItem user)
{
    successMessage = null;
    errorMessage = null;

    editingUser = user;

    editUserModel = new EditUserModel
    {
        DisplayName = user.DisplayName,
        Role = user.Role,
        TicketsModuleEnabled = user.TicketsModuleEnabled,
        OnboardingModuleEnabled = user.OnboardingModuleEnabled,
        TestingModuleEnabled = user.TestingModuleEnabled
        ,ProjectsModuleEnabled = user.ProjectsModuleEnabled
    };
}

private void CancelEdit()
{
    editingUser = null;
    editUserModel = new EditUserModel();
}

private void BeginPasswordReset(UserListItem user)
{
    successMessage = null;
    errorMessage = null;

    passwordResetUser = user;
    passwordResetModel = new PasswordResetModel();
}

private void CancelPasswordReset()
{
    passwordResetUser = null;
    passwordResetModel = new PasswordResetModel();
}

private void BeginDelete(UserListItem user)
{
    successMessage = null;
    errorMessage = null;

    if (user.Id == currentUserId)
    {
        errorMessage = "You cannot delete your own account.";
        return;
    }

    deletingUser = user;
}

private void CancelDelete()
{
    deletingUser = null;
}

private async Task DeleteUserAsync()
{
    if (deletingUser is null)
    {
        return;
    }

    successMessage = null;
    errorMessage = null;
    isDeletingUser = true;

    try
    {
        if (deletingUser.Id == currentUserId)
        {
            errorMessage = "You cannot delete your own account.";
            return;
        }

        var user =
            await UserManager.FindByIdAsync(deletingUser.Id);

        if (user is null)
        {
            errorMessage = "The selected user could not be found.";
            deletingUser = null;
            return;
        }

        var roles =
            await UserManager.GetRolesAsync(user);

        if (roles.Contains("Administrator"))
        {
            var administrators =
                await UserManager.GetUsersInRoleAsync("Administrator");

            if (administrators.Count <= 1)
            {
                errorMessage =
                    "You cannot delete the last remaining administrator.";

                return;
            }
        }

        var displayName =
            user.DisplayName ?? user.Email ?? "The user";

        var email = user.Email;

        var roleSummary =
            roles.Count == 0
                ? "No Role"
                : string.Join(", ", roles);

        var result =
            await UserManager.DeleteAsync(user);

        if (!result.Succeeded)
        {
            errorMessage = string.Join(
                " ",
                result.Errors.Select(
                    error => error.Description));

            return;
        }

        await AuditLogService.RecordAsync(
            "User deleted",
            user.Id,
            email,
            $"Deleted user with role {roleSummary}.");

        successMessage =
            $"{displayName} has been deleted.";

        deletingUser = null;

        await LoadUsersAsync();
    }
    finally
    {
        isDeletingUser = false;
    }
}

private async Task ResetPasswordAsync()
{
    if (passwordResetUser is null)
    {
        return;
    }

    successMessage = null;
    errorMessage = null;
    isResettingPassword = true;

    try
    {
        var user =
            await UserManager.FindByIdAsync(passwordResetUser.Id);

        if (user is null)
        {
            errorMessage =
                "The selected user could not be found.";

            return;
        }

        var resetToken =
            await UserManager.GeneratePasswordResetTokenAsync(user);

        var result =
            await UserManager.ResetPasswordAsync(
                user,
                resetToken,
                passwordResetModel.Password);

        if (!result.Succeeded)
        {
            errorMessage = string.Join(
                " ",
                result.Errors.Select(
                    error => error.Description));

            return;
        }

        await AuditLogService.RecordAsync(
            "Password reset",
            user.Id,
            user.Email,
            "Reset the user's password.");

        successMessage =
            $"The password for {user.DisplayName} has been reset.";

        passwordResetUser = null;
        passwordResetModel = new PasswordResetModel();
    }
    finally
    {
        isResettingPassword = false;
    }
}

private async Task SaveUserAsync()
{
    if (editingUser is null)
    {
        return;
    }

    successMessage = null;
    errorMessage = null;
    isSavingUser = true;

    try
    {
        var user =
            await UserManager.FindByIdAsync(editingUser.Id);

        if (user is null)
        {
            errorMessage =
                "The selected user could not be found.";

            return;
        }

        var displayName =
            editUserModel.DisplayName.Trim();

        var previousDisplayName =
            user.DisplayName ?? string.Empty;

        var previousTicketsModuleEnabled =
            editingUser.TicketsModuleEnabled;

        var previousOnboardingModuleEnabled =
            editingUser.OnboardingModuleEnabled;

        var previousTestingModuleEnabled =
            editingUser.TestingModuleEnabled;
        var previousProjectsModuleEnabled = editingUser.ProjectsModuleEnabled;

        var roleExists =
            await RoleManager.RoleExistsAsync(editUserModel.Role);

        if (!roleExists)
        {
            errorMessage =
                "The selected role does not exist.";

            return;
        }

        if (!string.Equals(user.DisplayName, displayName, StringComparison.Ordinal))
        {
            user.DisplayName = displayName;

            var updateResult =
                await UserManager.UpdateAsync(user);

            if (!updateResult.Succeeded)
            {
                errorMessage = string.Join(
                    " ",
                    updateResult.Errors.Select(
                        error => error.Description));

                return;
            }
        }

        var currentRoles =
    await UserManager.GetRolesAsync(user);

var isCurrentlyAdministrator =
    currentRoles.Contains("Administrator");

var isChangingAwayFromAdministrator =
    isCurrentlyAdministrator &&
    editUserModel.Role != "Administrator";

if (isChangingAwayFromAdministrator)
{
    var administrators =
        await UserManager.GetUsersInRoleAsync("Administrator");

    if (administrators.Count <= 1)
    {
        errorMessage =
            "You cannot remove the Administrator role from the last remaining administrator.";

        return;
    }
}

if (!currentRoles.Contains(editUserModel.Role))
{
    if (currentRoles.Count > 0)
    {
        var removeResult =
            await UserManager.RemoveFromRolesAsync(
                user,
                currentRoles);

        if (!removeResult.Succeeded)
        {
            errorMessage = string.Join(
                " ",
                removeResult.Errors.Select(
                    error => error.Description));

            return;
        }
    }

    var addRoleResult =
        await UserManager.AddToRoleAsync(
            user,
            editUserModel.Role);

    if (!addRoleResult.Succeeded)
    {
        errorMessage = string.Join(
            " ",
            addRoleResult.Errors.Select(
                error => error.Description));

        return;
    }
}

        var previousRole =
            currentRoles.FirstOrDefault() ?? "No Role";

        await ModuleAccessService.SetAccessAsync(
            user.Id,
            ModuleKeys.Tickets,
            editUserModel.TicketsModuleEnabled);

        await ModuleAccessService.SetAccessAsync(
            user.Id,
            ModuleKeys.Onboarding,
            editUserModel.OnboardingModuleEnabled);

        await ModuleAccessService.SetAccessAsync(
            user.Id,
            ModuleKeys.Testing,
            editUserModel.TestingModuleEnabled);
        await ModuleAccessService.SetAccessAsync(user.Id, ModuleKeys.Projects, editUserModel.ProjectsModuleEnabled);

        await AuditLogService.RecordAsync(
            "User updated",
            user.Id,
            user.Email,
            $"Display name: '{previousDisplayName}' to '{displayName}'. " +
            $"Role: {previousRole} to {editUserModel.Role}. " +
            $"Support Tickets: " +
            $"{(previousTicketsModuleEnabled ? "enabled" : "disabled")} to " +
            $"{(editUserModel.TicketsModuleEnabled ? "enabled" : "disabled")}. " +
            $"Customer Onboarding: " +
            $"{(previousOnboardingModuleEnabled ? "enabled" : "disabled")} to " +
            $"{(editUserModel.OnboardingModuleEnabled ? "enabled" : "disabled")}. " +
            $"Testing: {(previousTestingModuleEnabled ? "enabled" : "disabled")} to " +
            $"{(editUserModel.TestingModuleEnabled ? "enabled" : "disabled")}. " +
            $"Projects: {(previousProjectsModuleEnabled ? "enabled" : "disabled")} to " +
            $"{(editUserModel.ProjectsModuleEnabled ? "enabled" : "disabled")}.");

        successMessage =
            $"{displayName} has been updated.";

        editingUser = null;
        editUserModel = new EditUserModel();

        await LoadUsersAsync();
    }
    finally
    {
        isSavingUser = false;
    }
}


private sealed class EditUserModel
{
    [Required(
        ErrorMessage = "Please enter a display name.")]
    [StringLength(100)]
    public string DisplayName { get; set; } = string.Empty;

    [Required(
        ErrorMessage = "Please select a role.")]
    public string Role { get; set; } = string.Empty;

    public bool TicketsModuleEnabled { get; set; }

    public bool OnboardingModuleEnabled { get; set; }

    public bool TestingModuleEnabled { get; set; }
    public bool ProjectsModuleEnabled { get; set; }
}

private async Task LockUserAsync(UserListItem userItem)
{
    successMessage = null;
    errorMessage = null;

    if (userItem.Id == currentUserId)
    {
        errorMessage =
            "You cannot lock your own account.";

        return;
    }

    var user =
        await UserManager.FindByIdAsync(userItem.Id);

    if (user is null)
    {
        errorMessage =
            "The selected user could not be found.";

        return;
    }

    var result =
        await UserManager.SetLockoutEndDateAsync(
            user,
            DateTimeOffset.MaxValue);

    if (!result.Succeeded)
    {
        errorMessage = string.Join(
            " ",
            result.Errors.Select(
                error => error.Description));

        return;
    }

    await AuditLogService.RecordAsync(
        "User locked",
        user.Id,
        user.Email,
        "Locked the user account.");

    successMessage =
        $"{user.DisplayName} has been locked.";

    await LoadUsersAsync();
}

private async Task UnlockUserAsync(UserListItem userItem)
{
    successMessage = null;
    errorMessage = null;

    var user =
        await UserManager.FindByIdAsync(userItem.Id);

    if (user is null)
    {
        errorMessage = "The selected user could not be found.";
        return;
    }

    var result =
        await UserManager.SetLockoutEndDateAsync(
            user,
            null);

    if (!result.Succeeded)
    {
        errorMessage = string.Join(
            " ",
            result.Errors.Select(
                error => error.Description));

        return;
    }

    await AuditLogService.RecordAsync(
        "User unlocked",
        user.Id,
        user.Email,
        "Unlocked the user account.");

    successMessage =
        $"{user.DisplayName} has been unlocked.";

    await LoadUsersAsync();
}

private sealed class PasswordResetModel
{
    [Required(
        ErrorMessage = "Please enter a new password.")]
    [DataType(DataType.Password)]
    public string Password { get; set; } = string.Empty;

    [Required(
        ErrorMessage = "Please confirm the new password.")]
    [DataType(DataType.Password)]
    [Compare(
        nameof(Password),
        ErrorMessage = "The passwords do not match.")]
    public string ConfirmPassword { get; set; } = string.Empty;
}
}
